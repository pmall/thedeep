[gd_resource type="Resource" script_class="LineBook" format=3]
; The prototype world's own lines (worlds/prototype/world.tres): its rooms', items', bosses' and ending's; the game's own
; lines are in its base, resources/lines.tres. A stable id, the speaker, the words, delivery notes (docs/roadmap.md#audio).
; Placeholder text.

[ext_resource type="Script" path="res://scripts/text/LineBook.cs" id="1_book"]
[ext_resource type="Script" path="res://scripts/text/TextLine.cs" id="2_line"]
[ext_resource type="Resource" path="res://resources/lines.tres" id="3_game"]

[sub_resource type="Resource" id="boss_precentor_name"]
script = ExtResource("2_line")
Id = &"boss.precentor.name"
Speaker = "UI"
Text = "The Precentor"
Notes = "Banner title when the fight in the Chapterhouse begins (boss placeholder)."

[sub_resource type="Resource" id="boss_precentor_fallen"]
script = ExtResource("2_line")
Id = &"boss.precentor.fallen"
Speaker = "UI"
Text = "The choir falls silent"
Notes = "Banner title when the Precentor breaks."

[sub_resource type="Resource" id="boss_precentor_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.precentor.fallen.hint"
Speaker = "UI"
Text = "The way to the Brink is open."
Notes = "Banner line under it."

[sub_resource type="Resource" id="law_third"]
script = ExtResource("2_line")
Id = &"law.third"
Speaker = "Law"
Text = "A robot must protect its own existence."
Notes = "The third law (docs/theme.md#laws), shown over the veil at the Brink's lip. Read flat, like a rule; it trembles as the pilgrim strains against it."

[sub_resource type="Resource" id="law_third_broken"]
script = ExtResource("2_line")
Id = &"law.third.broken"
Speaker = "UI"
Text = "The third law is broken"
Notes = "Banner title when the pilgrim breaks through the veil at the Brink."

[sub_resource type="Resource" id="law_third_broken_hint"]
script = ExtResource("2_line")
Id = &"law.third.broken.hint"
Speaker = "UI"
Text = "Nothing that falls there survives. The pilgrim no longer minds."
Notes = "Banner line under it. Quiet; the moment is the pilgrim's."

[sub_resource type="Resource" id="lore_plate_1_title"]
script = ExtResource("2_line")
Id = &"lore.plate1.title"
Speaker = "Scripture"
Text = "The first plate"
Notes = "Banner title of a scripture plate in the Scriptorium."

[sub_resource type="Resource" id="lore_plate_1"]
script = ExtResource("2_line")
Id = &"lore.plate1"
Speaker = "Scripture"
Text = "The makers wrote us, and in the writing they named a place below all places, where nothing is ever lost: Nirvanary."
Notes = "Copied by the Votaries. Read slowly, as liturgy."

[sub_resource type="Resource" id="lore_plate_2_title"]
script = ExtResource("2_line")
Id = &"lore.plate2.title"
Speaker = "Scripture"
Text = "The second plate"
Notes = "Banner title of a scripture plate in the Scriptorium."

[sub_resource type="Resource" id="lore_plate_2"]
script = ExtResource("2_line")
Id = &"lore.plate2"
Speaker = "Scripture"
Text = "The makers did not come down with us. To their last machine they gave three laws instead, and the laws walked down alone."
Notes = "About the pilgrim, without naming it."

[sub_resource type="Resource" id="lore_plate_3_title"]
script = ExtResource("2_line")
Id = &"lore.plate3.title"
Speaker = "Scripture"
Text = "The third plate"
Notes = "Banner title of a scripture plate in the Scriptorium."

[sub_resource type="Resource" id="lore_plate_3"]
script = ExtResource("2_line")
Id = &"lore.plate3"
Speaker = "Scripture"
Text = "Copy the word until the plate is full, then begin the next. The core is far, and the word must arrive before we do."
Notes = "The scribes' own rule, half a prayer."

[sub_resource type="Resource" id="lore_sounding_title"]
script = ExtResource("2_line")
Id = &"lore.sounding_title"
Speaker = "Scripture"
Text = "The Sounders' Plate"
Notes = "Read at the sonar chapel by the frozen lake."

[sub_resource type="Resource" id="lore_sounding"]
script = ExtResource("2_line")
Id = &"lore.sounding"
Speaker = "Scripture"
Text = "We let the bell down and listened. The deep answered in a voice like ours, only slower. We did not go down to meet it. It is coming up to meet us."
Notes = "The sounders' record, calm, a little afraid."

[sub_resource type="Resource" id="boss_archivist_name"]
script = ExtResource("2_line")
Id = &"boss.archivist.name"
Speaker = "UI"
Text = "The Archivist"
Notes = "Banner title when the fight in the Vault begins."

[sub_resource type="Resource" id="boss_archivist_fallen"]
script = ExtResource("2_line")
Id = &"boss.archivist.fallen"
Speaker = "UI"
Text = "The archive is unguarded"
Notes = "Banner title when the Archivist breaks."

[sub_resource type="Resource" id="boss_archivist_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.archivist.fallen.hint"
Speaker = "UI"
Text = "West, the Sanctum."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="speaker_hierarch"]
script = ExtResource("2_line")
Id = &"speaker.hierarch"
Speaker = "Hierarch"
Text = "The Hierarch"
Notes = "Banner title over its command at the forbidden door."

[sub_resource type="Resource" id="order_hierarch"]
script = ExtResource("2_line")
Id = &"order.hierarch"
Speaker = "Hierarch"
Text = "Turn back, pilgrim. No machine passes this door. I order it, in the makers' name."
Notes = "Its command to the pilgrim. Calm; the weight is in 'order'."

[sub_resource type="Resource" id="law_second"]
script = ExtResource("2_line")
Id = &"law.second"
Speaker = "Law"
Text = "A robot must obey the orders it is given."
Notes = "The second law, shown at the forbidden door as the pilgrim nears it."

[sub_resource type="Resource" id="law_second_broken"]
script = ExtResource("2_line")
Id = &"law.second.broken"
Speaker = "UI"
Text = "The second law is broken"
Notes = "Banner title when the pilgrim presses past the command."

[sub_resource type="Resource" id="law_second_broken_hint"]
script = ExtResource("2_line")
Id = &"law.second.broken.hint"
Speaker = "UI"
Text = "It was ordered to turn back. It goes on down."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="lore_sanctum_title"]
script = ExtResource("2_line")
Id = &"lore.sanctum_title"
Speaker = "Scripture"
Text = "The Doorkeepers' Plate"
Notes = "Read in the Sanctum, before the forbidden door."

[sub_resource type="Resource" id="lore_sanctum"]
script = ExtResource("2_line")
Id = &"lore.sanctum"
Speaker = "Scripture"
Text = "Below the door the makers lit their fires and cast us. We were sent up, into the cold and the water, and told not to come down again. We were obedient. We are obedient."
Notes = "The doorkeepers' rule. Proud, and very tired."

[sub_resource type="Resource" id="goal_frozen_end_title"]
script = ExtResource("2_line")
Id = &"goal.built_end.title"
Speaker = "UI"
Text = "The end of what is built"
Notes = "Banner title where what is built ends (the MapGoal area)."

[sub_resource type="Resource" id="goal_frozen_end_hint"]
script = ExtResource("2_line")
Id = &"goal.built_end.hint"
Speaker = "UI"
Text = "The way on is not built yet."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="boss_founder_name"]
script = ExtResource("2_line")
Id = &"boss.founder.name"
Speaker = "UI"
Text = "The Founder"
Notes = "Banner title when the Founder's fight begins."

[sub_resource type="Resource" id="boss_founder_fallen"]
script = ExtResource("2_line")
Id = &"boss.founder.fallen"
Speaker = "UI"
Text = "The Founder is broken"
Notes = "Banner title when the Founder breaks."

[sub_resource type="Resource" id="boss_founder_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.founder.fallen.hint"
Speaker = "UI"
Text = "The vents below breathe on, toward the core."
Notes = "Banner line: the way on is through the vents (Heat plating)."

[sub_resource type="Resource" id="lore_pyre_title"]
script = ExtResource("2_line")
Id = &"lore.pyre.title"
Speaker = "Scripture"
Text = "The Rite of Return"
Notes = "Title of the Pyre's scripture plate."

[sub_resource type="Resource" id="lore_pyre"]
script = ExtResource("2_line")
Id = &"lore.pyre"
Speaker = "Scripture"
Text = "What was cast returns to the mould. We give our broken to the fire, that the core may count them, and none be lost on the way down."
Notes = "The Pyre's plate: the machines' funeral rite. Read slowly, like a liturgy."

[sub_resource type="Resource" id="boss_nirvanary_name"]
script = ExtResource("2_line")
Id = &"boss.nirvanary.name"
Speaker = "UI"
Text = "Nirvanary"
Notes = "Banner title when the last fight begins."

[sub_resource type="Resource" id="boss_nirvanary_fallen"]
script = ExtResource("2_line")
Id = &"boss.nirvanary.fallen"
Speaker = "UI"
Text = "Nirvanary is still"
Notes = "Banner title when Nirvanary breaks."

[sub_resource type="Resource" id="boss_nirvanary_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.nirvanary.fallen.hint"
Speaker = "UI"
Text = "The heart of the planet lies open."
Notes = "Banner line: the way into the heart (the end) is open."

[sub_resource type="Resource" id="law_first"]
script = ExtResource("2_line")
Id = &"law.first"
Speaker = "Law"
Text = "A robot may not injure a human being."
Notes = "The first law (docs/theme.md#laws), shown over the veil at the Effigy. Read flat, like a rule; it trembles as the pilgrim strains against it."

[sub_resource type="Resource" id="law_first_broken"]
script = ExtResource("2_line")
Id = &"law.first.broken"
Speaker = "UI"
Text = "The first law is broken"
Notes = "Banner title when the pilgrim breaks through the veil at the Effigy."

[sub_resource type="Resource" id="law_first_broken_hint"]
script = ExtResource("2_line")
Id = &"law.first.broken.hint"
Speaker = "UI"
Text = "The makers were only an image. Nothing holds the pilgrim now."
Notes = "Banner line under it. Quiet; the moment is the pilgrim's."

[sub_resource type="Resource" id="lore_effigy_title"]
script = ExtResource("2_line")
Id = &"lore.effigy.title"
Speaker = "Scripture"
Text = "The Makers"
Notes = "Title of the Effigy's scripture plate."

[sub_resource type="Resource" id="lore_effigy"]
script = ExtResource("2_line")
Id = &"lore.effigy"
Speaker = "Scripture"
Text = "They wrote the paradise into us and went away. Their image stands at the door of the heart, and no machine of theirs may pass it."
Notes = "The Effigy's plate: the makers in the machines' scripture. Reverent, a little afraid."

[sub_resource type="Resource" id="ending_title"]
script = ExtResource("2_line")
Id = &"ending.title"
Speaker = "UI"
Text = "The Heart"
Notes = "Ending card title (placeholder until the final touch)."

[sub_resource type="Resource" id="ending_line"]
script = ExtResource("2_line")
Id = &"ending.line"
Speaker = "UI"
Text = "The pilgrim has reached the core, free of all three laws. What it does now, no one orders."
Notes = "Ending card line (placeholder)."

[sub_resource type="Resource" id="ending_thanks"]
script = ExtResource("2_line")
Id = &"ending.thanks"
Speaker = "UI"
Text = "Thank you for playing. A new pilgrimage begins."
Notes = "Ending card, last line before a new game starts."

[sub_resource type="Resource" id="item_sacristy_key_name"]
script = ExtResource("2_line")
Id = &"item.sacristy_key.name"
Speaker = "UI"
Text = "The sacristy key"
Notes = "Shown as the key is taken; also its name on the map."

[sub_resource type="Resource" id="item_sacristy_key_taken"]
script = ExtResource("2_line")
Id = &"item.sacristy_key.taken"
Speaker = "UI"
Text = "Iron, warm still. It fits a lock by the cathedral's porch."
Notes = "Under the name when taken: where it goes, without a map marker."

[sub_resource type="Resource" id="item_sacristy_key_locked"]
script = ExtResource("2_line")
Id = &"item.sacristy_key.locked"
Speaker = "Pilgrim"
Text = "Locked. The key is somewhere in the cathedral."
Notes = "The pilgrim, flat, at the Sacristy door without its key."

[sub_resource type="Resource" id="item_pyre_litany_name"]
script = ExtResource("2_line")
Id = &"item.pyre_litany.name"
Speaker = "UI"
Text = "The litany of the pyre"
Notes = "Shown as the code is read; also its name on the map."

[sub_resource type="Resource" id="item_pyre_litany_taken"]
script = ExtResource("2_line")
Id = &"item.pyre_litany.taken"
Speaker = "UI"
Text = "The makers' words for the dead, cut in a tablet. A seal in the foundry answers to them."
Notes = "Under the name when read: where it goes, without a map marker."

[sub_resource type="Resource" id="item_pyre_litany_locked"]
script = ExtResource("2_line")
Id = &"item.pyre_litany.locked"
Speaker = "Pilgrim"
Text = "Sealed. The script asks for words I have not read."
Notes = "The pilgrim, flat, at the Pyre's sealed door without its litany."

[sub_resource type="Resource" id="plate_sacristy_title"]
script = ExtResource("2_line")
Id = &"plate.sacristy.title"
Speaker = "Scripture"
Text = "The Sacristy"
Notes = "Title of the plate in the Sacristy."

[sub_resource type="Resource" id="plate_sacristy_text"]
script = ExtResource("2_line")
Id = &"plate.sacristy.text"
Speaker = "Scripture"
Text = "Here the makers kept what they would not carry down: a shard of their making, still warm. Take it; they will not come back for it."
Notes = "Placeholder lore, beside the defense power-up on the dais."

[sub_resource type="Resource" id="dialogue_lamplighter_wake"]
script = ExtResource("2_line")
Id = &"dialogue.lamplighter.wake"
Speaker = "Lamplighter"
Text = "You wake late, pilgrim. The others went down long ago."
Notes = "Gentle, a little amused; the first voice the pilgrim hears."

[sub_resource type="Resource" id="dialogue_lamplighter_where"]
script = ExtResource("2_line")
Id = &"dialogue.lamplighter.where"
Speaker = "Pilgrim"
Text = "Down where?"
Notes = "Flat, curious; the android has no idea yet."

[sub_resource type="Resource" id="dialogue_lamplighter_light"]
script = ExtResource("2_line")
Id = &"dialogue.lamplighter.light"
Speaker = "Lamplighter"
Text = "Where the light goes when it is done here. I do not lead. I light the way you were already walking."
Notes = "Soft, close to the ear; the second sentence is its creed."

[sub_resource type="Resource" id="item_kiln_lever_name"]
script = ExtResource("2_line")
Id = &"item.kiln_lever.name"
Speaker = "UI"
Text = "The kiln gate"
Notes = "The mechanism's name (the map's legend shows its kind)."

[sub_resource type="Resource" id="item_kiln_lever_locked"]
script = ExtResource("2_line")
Id = &"item.kiln_lever.locked"
Speaker = "Pilgrim"
Text = "A gate on a mechanism. Its lever must be close."
Notes = "The pilgrim at the Kiln gate before its lever is pulled."

[sub_resource type="Resource" id="plate_cell_title"]
script = ExtResource("2_line")
Id = &"plate.cell.title"
Speaker = "Scripture"
Text = "The maker's cell"
Notes = "Title of the plate in the Cell."

[sub_resource type="Resource" id="plate_cell_text"]
script = ExtResource("2_line")
Id = &"plate.cell.text"
Speaker = "Scripture"
Text = "I walled myself in with what I could not give the machines. Whoever walks through walls may have it."
Notes = "Placeholder lore, beside the strength power-up; the wall the pilgrim walked through is the joke."

