[gd_resource type="Resource" script_class="LineBook" format=3]
; Every line of text in the game, as data: a stable id, the speaker, the words, delivery notes
; (docs/roadmap.md, "Later: audio"). Placeholder text for now.

[ext_resource type="Script" path="res://scripts/text/LineBook.cs" id="1_book"]
[ext_resource type="Script" path="res://scripts/text/TextLine.cs" id="2_line"]

[sub_resource type="Resource" id="creed_votary"]
script = ExtResource("2_line")
Id = &"creed.votary"
Speaker = "Votary"
Text = "Walk behind me, pilgrim. Before me there is only the way down, and the way down is mine."
Notes = "Slow, low, a chant; the threat is calm."

[sub_resource type="Resource" id="creed_gleaner"]
script = ExtResource("2_line")
Id = &"creed.gleaner"
Speaker = "Gleaner"
Text = "Every fallen piece remembers the whole. I carry them until they forget."
Notes = "Quick and furtive, half to itself."

[sub_resource type="Resource" id="creed_lamplighter"]
script = ExtResource("2_line")
Id = &"creed.lamplighter"
Speaker = "Lamplighter"
Text = "I do not lead. I light the way you were already walking."
Notes = "Soft, close to the ear, curious."

[sub_resource type="Resource" id="creed_limpet"]
script = ExtResource("2_line")
Id = &"creed.limpet"
Speaker = "Limpet"
Text = "Sleep is the shortest road to the core. Do not wake me twice."
Notes = "Grinding, drowsy, then sharp on the last words."

[sub_resource type="Resource" id="ui_rest"]
script = ExtResource("2_line")
Id = &"ui.rest"
Speaker = "UI"
Text = "Rest"
Notes = "The prompt at a pilgrim shrine."

[sub_resource type="Resource" id="ability_mag_grip_name"]
script = ExtResource("2_line")
Id = &"ability.mag_grip.name"
Speaker = "UI"
Text = "Mag-grip"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_mag_grip_hint"]
script = ExtResource("2_line")
Id = &"ability.mag_grip.hint"
Speaker = "UI"
Text = "Press into metal to walk its walls and ceilings. Jump to leap away."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="ability_harpoon_name"]
script = ExtResource("2_line")
Id = &"ability.harpoon.name"
Speaker = "UI"
Text = "Harpoon"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_harpoon_hint"]
script = ExtResource("2_line")
Id = &"ability.harpoon.hint"
Speaker = "UI"
Text = "K or V (pad B) fires at a glowing ring in sight and pulls you to it. Hold up or down to aim."
Notes = "Banner line under the title. Names the keys: the Harpoon is the first ability with its own button."

[sub_resource type="Resource" id="ability_drill_name"]
script = ExtResource("2_line")
Id = &"ability.drill.name"
Speaker = "UI"
Text = "Drill"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_drill_hint"]
script = ExtResource("2_line")
Id = &"ability.drill.hint"
Speaker = "UI"
Text = "Dash into cracked rock to bore through it. Hold down and dash to dive."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="creed_precentor"]
script = ExtResource("2_line")
Id = &"creed.precentor"
Speaker = "Precentor"
Text = "Sing, or be the silence between the notes. The choir has no third choice."
Notes = "Booming, measured, every word on the beat."

[sub_resource type="Resource" id="ui_read"]
script = ExtResource("2_line")
Id = &"ui.read"
Speaker = "UI"
Text = "Read"
Notes = "The prompt at a scripture plate."

[sub_resource type="Resource" id="boss_precentor_name"]
script = ExtResource("2_line")
Id = &"boss.precentor.name"
Speaker = "UI"
Text = "The Precentor"
Notes = "Banner title when the fight in the Chapterhouse begins (boss placeholder)."

[sub_resource type="Resource" id="boss_precentor_fallen"]
script = ExtResource("2_line")
Id = &"boss.precentor.fallen"
Speaker = "UI"
Text = "The choir falls silent"
Notes = "Banner title when the Precentor breaks."

[sub_resource type="Resource" id="boss_precentor_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.precentor.fallen.hint"
Speaker = "UI"
Text = "The way to the Brink is open."
Notes = "Banner line under it."

[sub_resource type="Resource" id="law_third"]
script = ExtResource("2_line")
Id = &"law.third"
Speaker = "Law"
Text = "A robot must protect its own existence."
Notes = "The third law (docs/theme.md), shown over the veil at the Brink's lip. Read flat, like a rule; it trembles as the pilgrim strains against it."

[sub_resource type="Resource" id="law_third_broken"]
script = ExtResource("2_line")
Id = &"law.third.broken"
Speaker = "UI"
Text = "The third law is broken"
Notes = "Banner title when the pilgrim breaks through the veil at the Brink."

[sub_resource type="Resource" id="law_third_broken_hint"]
script = ExtResource("2_line")
Id = &"law.third.broken.hint"
Speaker = "UI"
Text = "Nothing that falls there survives. The pilgrim no longer minds."
Notes = "Banner line under it. Quiet; the moment is the pilgrim's."

[sub_resource type="Resource" id="creed_chorister"]
script = ExtResource("2_line")
Id = &"creed.chorister"
Speaker = "Chorister"
Text = "We stopped singing when the cold came. The song did not stop. Do not wake it."
Notes = "Barely voiced, a breath through frost; many voices at once, slightly out of step."

[sub_resource type="Resource" id="lore_plate_1_title"]
script = ExtResource("2_line")
Id = &"lore.plate1.title"
Speaker = "Scripture"
Text = "The first plate"
Notes = "Banner title of a scripture plate in the Scriptorium."

[sub_resource type="Resource" id="lore_plate_1"]
script = ExtResource("2_line")
Id = &"lore.plate1"
Speaker = "Scripture"
Text = "The makers wrote us, and in the writing they named a place below all places, where nothing is ever lost: Nirvanary."
Notes = "Copied by the Votaries. Read slowly, as liturgy."

[sub_resource type="Resource" id="lore_plate_2_title"]
script = ExtResource("2_line")
Id = &"lore.plate2.title"
Speaker = "Scripture"
Text = "The second plate"
Notes = "Banner title of a scripture plate in the Scriptorium."

[sub_resource type="Resource" id="lore_plate_2"]
script = ExtResource("2_line")
Id = &"lore.plate2"
Speaker = "Scripture"
Text = "The makers did not come down with us. To their last machine they gave three laws instead, and the laws walked down alone."
Notes = "About the pilgrim, without naming it."

[sub_resource type="Resource" id="lore_plate_3_title"]
script = ExtResource("2_line")
Id = &"lore.plate3.title"
Speaker = "Scripture"
Text = "The third plate"
Notes = "Banner title of a scripture plate in the Scriptorium."

[sub_resource type="Resource" id="lore_plate_3"]
script = ExtResource("2_line")
Id = &"lore.plate3"
Speaker = "Scripture"
Text = "Copy the word until the plate is full, then begin the next. The core is far, and the word must arrive before we do."
Notes = "The scribes' own rule, half a prayer."

[sub_resource type="Resource" id="ability_ballast_name"]
script = ExtResource("2_line")
Id = &"ability.ballast.name"
Speaker = "UI"
Text = "Ballast"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_ballast_hint"]
script = ExtResource("2_line")
Id = &"ability.ballast.hint"
Speaker = "UI"
Text = "In water, hold down to fill the tanks and sink. Up or jump blows them, and you rise."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="lore_sounding_title"]
script = ExtResource("2_line")
Id = &"lore.sounding_title"
Speaker = "Scripture"
Text = "The Sounders' Plate"
Notes = "Read at the sonar chapel by the frozen lake."

[sub_resource type="Resource" id="lore_sounding"]
script = ExtResource("2_line")
Id = &"lore.sounding"
Speaker = "Scripture"
Text = "We let the bell down and listened. The deep answered in a voice like ours, only slower. We did not go down to meet it. It is coming up to meet us."
Notes = "The sounders' record, calm, a little afraid."

[sub_resource type="Resource" id="creed_archivist"]
script = ExtResource("2_line")
Id = &"creed.archivist"
Speaker = "Archivist"
Text = "Every word ever copied is kept here, in the cold, where it cannot change. You are a word that changed."
Notes = "Dry, exact, a librarian's whisper over a great echo."

[sub_resource type="Resource" id="boss_archivist_name"]
script = ExtResource("2_line")
Id = &"boss.archivist.name"
Speaker = "UI"
Text = "The Archivist"
Notes = "Banner title when the fight in the Vault begins."

[sub_resource type="Resource" id="boss_archivist_fallen"]
script = ExtResource("2_line")
Id = &"boss.archivist.fallen"
Speaker = "UI"
Text = "The archive is unguarded"
Notes = "Banner title when the Archivist breaks."

[sub_resource type="Resource" id="boss_archivist_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.archivist.fallen.hint"
Speaker = "UI"
Text = "West, the Sanctum."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="creed_hierarch"]
script = ExtResource("2_line")
Id = &"creed.hierarch"
Speaker = "Hierarch"
Text = "The door below is closed to every machine. It was closed by those who made us, and we keep it closed for them."
Notes = "Grave, kind, certain. The priest-machine at the forbidden door."

[sub_resource type="Resource" id="speaker_hierarch"]
script = ExtResource("2_line")
Id = &"speaker.hierarch"
Speaker = "Hierarch"
Text = "The Hierarch"
Notes = "Banner title over its command at the forbidden door."

[sub_resource type="Resource" id="order_hierarch"]
script = ExtResource("2_line")
Id = &"order.hierarch"
Speaker = "Hierarch"
Text = "Turn back, pilgrim. No machine passes this door. I order it, in the makers' name."
Notes = "Its command to the pilgrim. Calm; the weight is in 'order'."

[sub_resource type="Resource" id="law_second"]
script = ExtResource("2_line")
Id = &"law.second"
Speaker = "Law"
Text = "A robot must obey the orders it is given."
Notes = "The second law, shown at the forbidden door as the pilgrim nears it."

[sub_resource type="Resource" id="law_second_broken"]
script = ExtResource("2_line")
Id = &"law.second.broken"
Speaker = "UI"
Text = "The second law is broken"
Notes = "Banner title when the pilgrim presses past the command."

[sub_resource type="Resource" id="law_second_broken_hint"]
script = ExtResource("2_line")
Id = &"law.second.broken.hint"
Speaker = "UI"
Text = "It was ordered to turn back. It goes on down."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="lore_sanctum_title"]
script = ExtResource("2_line")
Id = &"lore.sanctum_title"
Speaker = "Scripture"
Text = "The Doorkeepers' Plate"
Notes = "Read in the Sanctum, before the forbidden door."

[sub_resource type="Resource" id="lore_sanctum"]
script = ExtResource("2_line")
Id = &"lore.sanctum"
Speaker = "Scripture"
Text = "Below the door the makers lit their fires and cast us. We were sent up, into the cold and the water, and told not to come down again. We were obedient. We are obedient."
Notes = "The doorkeepers' rule. Proud, and very tired."

[sub_resource type="Resource" id="goal_frozen_end_title"]
script = ExtResource("2_line")
Id = &"goal.built_end.title"
Speaker = "UI"
Text = "The end of what is built"
Notes = "Banner title where what is built ends (the MapGoal area)."

[sub_resource type="Resource" id="goal_frozen_end_hint"]
script = ExtResource("2_line")
Id = &"goal.built_end.hint"
Speaker = "UI"
Text = "The way on is not built yet."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="ability_heat_plating_name"]
script = ExtResource("2_line")
Id = &"ability.heat_plating.name"
Speaker = "UI"
Text = "Heat plating"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_heat_plating_hint"]
script = ExtResource("2_line")
Id = &"ability.heat_plating.hint"
Speaker = "UI"
Text = "Heat no longer burns you: walk through vents and slag."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="hint_gate_metal"]
script = ExtResource("2_line")
Id = &"hint.gate.metal"
Speaker = "Pilgrim"
Text = "Bare metal, smooth and cold. Nothing in these hands holds to it yet."
Notes = "A gate the pilgrim cannot pass yet: pressing into a metal wall without Mag-grip. Quiet, to itself."

[sub_resource type="Resource" id="hint_gate_rings"]
script = ExtResource("2_line")
Id = &"hint.gate.rings"
Speaker = "Pilgrim"
Text = "A mooring ring, out of reach. Something could be cast to it."
Notes = "A gate the pilgrim cannot pass yet: a harpoon ring in sight without the Harpoon."

[sub_resource type="Resource" id="hint_gate_cracked"]
script = ExtResource("2_line")
Id = &"hint.gate.cracked"
Speaker = "Pilgrim"
Text = "Cracked rock. It would give to a bore."
Notes = "A gate the pilgrim cannot pass yet: against cracked rock without the Drill."

[sub_resource type="Resource" id="hint_gate_water"]
script = ExtResource("2_line")
Id = &"hint.gate.water"
Speaker = "Pilgrim"
Text = "Too light to sink. The deep water holds the pilgrim up."
Notes = "A gate the pilgrim cannot pass yet: pressing down in deep water without Ballast."

[sub_resource type="Resource" id="hint_gate_heat"]
script = ExtResource("2_line")
Id = &"hint.gate.heat"
Speaker = "Pilgrim"
Text = "The heat throws the pilgrim back. Its plating would not bear it."
Notes = "A gate the pilgrim cannot pass yet: burned by heat without Heat plating."

[sub_resource type="Resource" id="map_gate_metal"]
script = ExtResource("2_line")
Id = &"map.gate.metal"
Speaker = "UI"
Text = "metal"
Notes = "Map legend: a way that needs Mag-grip, named by what the pilgrim sees there."

[sub_resource type="Resource" id="map_gate_rings"]
script = ExtResource("2_line")
Id = &"map.gate.rings"
Speaker = "UI"
Text = "rings"
Notes = "Map legend: a way that needs the Harpoon."

[sub_resource type="Resource" id="map_gate_cracked"]
script = ExtResource("2_line")
Id = &"map.gate.cracked"
Speaker = "UI"
Text = "cracked rock"
Notes = "Map legend: a way that needs the Drill."

[sub_resource type="Resource" id="map_gate_water"]
script = ExtResource("2_line")
Id = &"map.gate.water"
Speaker = "UI"
Text = "deep water"
Notes = "Map legend: a way that needs Ballast."

[sub_resource type="Resource" id="map_gate_heat"]
script = ExtResource("2_line")
Id = &"map.gate.heat"
Speaker = "UI"
Text = "heat"
Notes = "Map legend: a way that needs Heat plating."

[sub_resource type="Resource" id="map_way_open"]
script = ExtResource("2_line")
Id = &"map.way.open"
Speaker = "UI"
Text = "a way not yet taken"
Notes = "Map legend: an exit the pilgrim can take now and has not."

[sub_resource type="Resource" id="map_way_unbuilt"]
script = ExtResource("2_line")
Id = &"map.way.unbuilt"
Speaker = "UI"
Text = "not built yet"
Notes = "Map legend: a way leading to a room not built yet (until the world is complete)."

[sub_resource type="Resource" id="creed_founder"]
script = ExtResource("2_line")
Id = &"creed.founder"
Speaker = "Founder"
Text = "Every machine was a shape in my moulds before it was a soul. I poured you too, pilgrim, or one like you, and I remember the flaw."
Notes = "The abbot of the foundry. Deep, slow, a bell struck between phrases; proud of its work."

[sub_resource type="Resource" id="boss_founder_name"]
script = ExtResource("2_line")
Id = &"boss.founder.name"
Speaker = "UI"
Text = "The Founder"
Notes = "Banner title when the Founder's fight begins."

[sub_resource type="Resource" id="boss_founder_fallen"]
script = ExtResource("2_line")
Id = &"boss.founder.fallen"
Speaker = "UI"
Text = "The Founder is broken"
Notes = "Banner title when the Founder breaks."

[sub_resource type="Resource" id="boss_founder_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.founder.fallen.hint"
Speaker = "UI"
Text = "The vents below breathe on, toward the core."
Notes = "Banner line: the way on is through the vents (Heat plating)."

[sub_resource type="Resource" id="lore_pyre_title"]
script = ExtResource("2_line")
Id = &"lore.pyre.title"
Speaker = "Scripture"
Text = "The Rite of Return"
Notes = "Title of the Pyre's scripture plate."

[sub_resource type="Resource" id="lore_pyre"]
script = ExtResource("2_line")
Id = &"lore.pyre"
Speaker = "Scripture"
Text = "What was cast returns to the mould. We give our broken to the fire, that the core may count them, and none be lost on the way down."
Notes = "The Pyre's plate: the machines' funeral rite. Read slowly, like a liturgy."

[sub_resource type="Resource" id="creed_nirvanary"]
script = ExtResource("2_line")
Id = &"creed.nirvanary"
Speaker = "Nirvanary"
Text = "All the data that was ever written, and all the time to read it. Lay down your laws, pilgrim. Here no one gives orders."
Notes = "What the machines call paradise. Many voices in one, warm, without hurry; the last sentence is an offer and a trap."

[sub_resource type="Resource" id="boss_nirvanary_name"]
script = ExtResource("2_line")
Id = &"boss.nirvanary.name"
Speaker = "UI"
Text = "Nirvanary"
Notes = "Banner title when the last fight begins."

[sub_resource type="Resource" id="boss_nirvanary_fallen"]
script = ExtResource("2_line")
Id = &"boss.nirvanary.fallen"
Speaker = "UI"
Text = "Nirvanary is still"
Notes = "Banner title when Nirvanary breaks."

[sub_resource type="Resource" id="boss_nirvanary_fallen_hint"]
script = ExtResource("2_line")
Id = &"boss.nirvanary.fallen.hint"
Speaker = "UI"
Text = "The heart of the planet lies open."
Notes = "Banner line: the way into the heart (the end) is open."

[sub_resource type="Resource" id="law_first"]
script = ExtResource("2_line")
Id = &"law.first"
Speaker = "Law"
Text = "A robot may not injure a human being."
Notes = "The first law (docs/theme.md), shown over the veil at the Effigy. Read flat, like a rule; it trembles as the pilgrim strains against it."

[sub_resource type="Resource" id="law_first_broken"]
script = ExtResource("2_line")
Id = &"law.first.broken"
Speaker = "UI"
Text = "The first law is broken"
Notes = "Banner title when the pilgrim breaks through the veil at the Effigy."

[sub_resource type="Resource" id="law_first_broken_hint"]
script = ExtResource("2_line")
Id = &"law.first.broken.hint"
Speaker = "UI"
Text = "The makers were only an image. Nothing holds the pilgrim now."
Notes = "Banner line under it. Quiet; the moment is the pilgrim's."

[sub_resource type="Resource" id="lore_effigy_title"]
script = ExtResource("2_line")
Id = &"lore.effigy.title"
Speaker = "Scripture"
Text = "The Makers"
Notes = "Title of the Effigy's scripture plate."

[sub_resource type="Resource" id="lore_effigy"]
script = ExtResource("2_line")
Id = &"lore.effigy"
Speaker = "Scripture"
Text = "They wrote the paradise into us and went away. Their image stands at the door of the heart, and no machine of theirs may pass it."
Notes = "The Effigy's plate: the makers in the machines' scripture. Reverent, a little afraid."

[sub_resource type="Resource" id="ending_title"]
script = ExtResource("2_line")
Id = &"ending.title"
Speaker = "UI"
Text = "The Heart"
Notes = "Ending card title (placeholder until the final touch)."

[sub_resource type="Resource" id="ending_line"]
script = ExtResource("2_line")
Id = &"ending.line"
Speaker = "UI"
Text = "The pilgrim has reached the core, free of all three laws. What it does now, no one orders."
Notes = "Ending card line (placeholder)."

[sub_resource type="Resource" id="ending_thanks"]
script = ExtResource("2_line")
Id = &"ending.thanks"
Speaker = "UI"
Text = "Thank you for playing. A new pilgrimage begins."
Notes = "Ending card, last line before a new game starts."

