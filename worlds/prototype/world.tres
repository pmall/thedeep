[gd_resource type="Resource" script_class="WorldDefinition" format=3]
; The prototype world (docs/roadmap.md, stage A): our playground, 40 rooms over the flooded, frozen and volcanic layers and
; the core, where every brick is proven. Its network is map-draft.md beside this file; the lab rooms (MechanicsLab,
; MachineArena) sit with its rooms, outside the game (Room.InGame off).

[ext_resource type="Script" path="res://scripts/world/WorldDefinition.cs" id="1_world"]
[ext_resource type="Script" path="res://scripts/world/WorldLayer.cs" id="2_layer"]
[ext_resource type="PackedScene" path="res://worlds/prototype/rooms/Narthex.tscn" id="3_start"]
[ext_resource type="Resource" path="res://worlds/prototype/lines.tres" id="4_lines"]
[ext_resource type="Resource" path="res://resources/biomes/flooded.tres" id="5_flooded"]
[ext_resource type="Resource" path="res://resources/biomes/frozen.tres" id="6_frozen"]
[ext_resource type="Resource" path="res://resources/biomes/volcanic.tres" id="7_volcanic"]
[ext_resource type="Resource" path="res://resources/biomes/core.tres" id="8_core"]

[sub_resource type="Resource" id="layer_flooded"]
script = ExtResource("2_layer")
Name = "Flooded"
Biome = ExtResource("5_flooded")

[sub_resource type="Resource" id="layer_frozen"]
script = ExtResource("2_layer")
Name = "Frozen"
Biome = ExtResource("6_frozen")

[sub_resource type="Resource" id="layer_volcanic"]
script = ExtResource("2_layer")
Name = "Volcanic"
Biome = ExtResource("7_volcanic")

[sub_resource type="Resource" id="layer_core"]
script = ExtResource("2_layer")
Name = "Core"
Biome = ExtResource("8_core")

[resource]
script = ExtResource("1_world")
RoomsFolder = "res://worlds/prototype/rooms"
Network = "res://worlds/prototype/map-draft.md"
StartRoom = ExtResource("3_start")
Layers = [SubResource("layer_flooded"), SubResource("layer_frozen"), SubResource("layer_volcanic"), SubResource("layer_core")]
Lines = ExtResource("4_lines")
SaveName = "save"
