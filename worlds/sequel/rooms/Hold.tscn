[gd_scene format=3]

; The Hold, up the Locks' iron wall: a cargo hold of the sea-wall, its walls all rock (no grip here). The Harpoon on a cradle
; mid-floor. Two mooring rings rise to a ledge high on the east wall and the way on to the Weir (Harpoon); the Strongroom's key
; lies on that ledge. West, the doorway back out onto the top of the Locks' iron wall.

[ext_resource type="Material" path="res://assets/materials/wet_stone.tres" id="1_wet_stone"]
[ext_resource type="PackedScene" path="res://scenes/kit/Block.tscn" id="2_block"]
[ext_resource type="Script" path="res://scripts/rooms/RoomExit.cs" id="3_exit"]
[ext_resource type="PackedScene" path="res://scenes/props/AbilityRelic.tscn" id="4_relic"]
[ext_resource type="PackedScene" path="res://scenes/props/HarpoonAnchor.tscn" id="5_anchor"]
[ext_resource type="Resource" path="res://worlds/sequel/items/strongroom_key.tres" id="6_item_strongroom_key"]
[ext_resource type="PackedScene" path="res://scenes/props/ItemPickup.tscn" id="7_pickup"]
[ext_resource type="PackedScene" path="res://scenes/props/Shrine.tscn" id="8_shrine"]
