[node name="SpawnPoint" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30, 0, 0)

; The shared atmosphere stack (environment, key light, clear front air, skylines, far pillars, frame, dust).
[node name="Stage" parent="." instance=ExtResource("16_stage")]
Seed = 31
DustDensity = 1.6
PillarDensity = 2.5

[node name="Geometry" type="Node3D" parent="."]

; the dock's floor, between the two doorways' sills (each Doorway frames X marker ± 2.5, Y -2 to 0 and 4 to 6)
[node name="Floor" parent="Geometry" instance=ExtResource("2_block")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 16, -2, 0)
Size = Vector3(29, 4, 4)
Material = ExtResource("1_wet_stone")

; the roof, wall to wall: the doorways' walls rise to it, deep enough to take each gate when it rises
[node name="Ceiling" parent="Geometry" instance=ExtResource("2_block")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 16, 15.5, 0)
Size = Vector3(39, 3, 4)

