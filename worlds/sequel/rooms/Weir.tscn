[gd_scene format=3]

; The Weir, through the Hold's high doorway: a weir across the sea-wall's channel, a pool of open brine in its floor. East, the
; way on to the Beacon, barred by a sluice gate; its lever stands a few steps back from it (a switch and its mechanism).

[ext_resource type="Material" path="res://assets/materials/wet_stone.tres" id="1_wet_stone"]
[ext_resource type="PackedScene" path="res://scenes/kit/Block.tscn" id="2_block"]
[ext_resource type="Script" path="res://scripts/rooms/RoomExit.cs" id="3_exit"]
[ext_resource type="Resource" path="res://worlds/sequel/items/weir_lever.tres" id="4_item_weir_lever"]
[ext_resource type="PackedScene" path="res://scenes/props/LockedDoor.tscn" id="5_door"]
[ext_resource type="PackedScene" path="res://scenes/props/Lever.tscn" id="6_lever"]
[ext_resource type="Script" path="res://scripts/rooms/WaterBody.cs" id="7_water_body"]
[ext_resource type="Material" path="res://assets/materials/water.tres" id="8_water"]
[ext_resource type="Material" path="res://assets/materials/water_section.tres" id="10_water_section"]
