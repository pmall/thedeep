[gd_scene format=3]

; The Quay (the sequel world's start, worlds/sequel/network.md): a landing on a sea-wall frozen in brine, where the pilgrim
; wakes. A shrine, a Lamplighter that comes to meet the pilgrim and talks (once), a bollard to hop. East, the doorway into the
; Locks. West, the Strongroom's doorway, barred by a locked door (its key lies on the Hold's high ledge).

[ext_resource type="Material" path="res://assets/materials/wet_stone.tres" id="1_wet_stone"]
[ext_resource type="PackedScene" path="res://scenes/kit/Block.tscn" id="2_block"]
[ext_resource type="Script" path="res://scripts/rooms/RoomExit.cs" id="3_exit"]
[ext_resource type="Resource" path="res://worlds/sequel/items/strongroom_key.tres" id="4_item_strongroom_key"]
[ext_resource type="PackedScene" path="res://scenes/props/LockedDoor.tscn" id="5_door"]
[ext_resource type="PackedScene" path="res://scenes/props/Shrine.tscn" id="6_shrine"]
[ext_resource type="Script" path="res://scripts/machines/Machine.cs" id="7_machine"]
[ext_resource type="Resource" path="res://resources/machines/lamplighter.tres" id="8_lamplighter"]
[ext_resource type="PackedScene" path="res://scenes/props/Conversation.tscn" id="9_conversation"]
[ext_resource type="Script" path="res://scripts/dialogue/DialogueLine.cs" id="90_dialogue_line"]
[ext_resource type="Material" path="res://assets/materials/glyphs.tres" id="10_glyphs"]
[ext_resource type="PackedScene" path="res://scenes/fx/Drips.tscn" id="11_drips"]
