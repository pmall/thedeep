[ext_resource type="Script" path="res://scripts/rooms/Room.cs" id="13_room"]
[ext_resource type="Resource" path="res://resources/biomes/brine.tres" id="14_brine"]
[ext_resource type="PackedScene" path="res://scenes/stage/RoomStage.tscn" id="15_stage"]
[ext_resource type="PackedScene" path="res://scenes/kit/Doorway.tscn" id="90_doorway"]
[ext_resource type="Resource" path="res://resources/seams/doorway.tres" id="91_seam"]

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(5, 0.3)

[sub_resource type="Resource" id="Said_wake"]
script = ExtResource("90_dialogue_line")
Speaker = &"speaker.lamplighter"
Line = &"dialogue.quay_lamplighter.wake"

[sub_resource type="Resource" id="Said_sea"]
script = ExtResource("90_dialogue_line")
Speaker = &"speaker.lamplighter"
Line = &"dialogue.quay_lamplighter.sea"

[sub_resource type="Resource" id="Said_down"]
script = ExtResource("90_dialogue_line")
Speaker = &"speaker.lamplighter"
Line = &"dialogue.quay_lamplighter.down"

[node name="Quay" type="Node3D" node_paths=PackedStringArray("SpawnPoint", "Stage", "Lamps", "Shafts", "GlyphLights")]
script = ExtResource("13_room")
SpawnPoint = NodePath("SpawnPoint")
Stage = NodePath("Stage")
Biome = ExtResource("14_brine")
Lamps = [NodePath("Lamps/Door")]
Shafts = [NodePath("Shafts/Shrine")]
GlyphLights = [NodePath("Props/Shrine/Light"), NodePath("Glyphs/DaisLight")]
BoundsMin = Vector2(-1.5, -2)
BoundsMax = Vector2(37.5, 15)

[node name="SpawnPoint" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5, 0, 0)

; The shared atmosphere stack (environment, key light, clear front air, skylines, far pillars, frame, dust).
[node name="Stage" parent="." instance=ExtResource("15_stage")]
Seed = 21
DustDensity = 2
PillarDensity = 3

[node name="Geometry" type="Node3D" parent="."]

[node name="Floor" parent="Geometry" instance=ExtResource("2_block")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 18, -2, 0)
Size = Vector3(33, 4, 4)
Material = ExtResource("1_wet_stone")

[node name="Ceiling" parent="Geometry" instance=ExtResource("2_block")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 18, 15.5, 0)
Size = Vector3(44, 3, 4)

; an iron bollard frozen to the quay: a hop
[node name="Bollard" parent="Geometry" instance=ExtResource("2_block")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 23.25, 0.75, 0)
Size = Vector3(2.5, 1.5, 4)

; the shrine on a low dais
[node name="Dais" parent="Geometry" instance=ExtResource("2_block")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12, 0.25, 0)
Size = Vector3(6, 0.5, 4)

[node name="Exits" type="Node3D" parent="."]

; west doorway into the Strongroom, barred by its locked door
[node name="West" type="Marker3D" parent="Exits" node_paths=PackedStringArray("Door")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1, 0, 0)
script = ExtResource("3_exit")
Side = 0
TargetRoom = "res://worlds/sequel/rooms/Strongroom.tscn"
TargetExit = "East"
Requires = "StrongroomKey"
Door = NodePath("../../Props/StrongroomDoor")

[node name="Doorway" parent="Exits/West" instance=ExtResource("90_doorway")]
Profile = ExtResource("91_seam")

; east doorway into the Locks
[node name="East" type="Marker3D" parent="Exits"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 37, 0, 0)
script = ExtResource("3_exit")
Side = 1
TargetRoom = "res://worlds/sequel/rooms/Locks.tscn"
TargetExit = "West"

[node name="Doorway" parent="Exits/East" instance=ExtResource("90_doorway")]
Profile = ExtResource("91_seam")

[node name="Props" type="Node3D" parent="."]

; the Strongroom's locked door, under the doorway's head
[node name="StrongroomDoor" parent="Props" instance=ExtResource("5_door")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 0, 0)
Item = ExtResource("4_item_strongroom_key")

; a pilgrim shrine on the dais: rest here to save and heal
[node name="Shrine" parent="Props" instance=ExtResource("6_shrine")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12, 0.5, 0)

[node name="Machines" type="Node3D" parent="."]

; a Lamplighter waits over the bollard and follows the pilgrim
[node name="Lamplighter" type="CharacterBody3D" parent="Machines"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 20, 5.5, 0)
script = ExtResource("7_machine")
Species = ExtResource("8_lamplighter")
StartFacing = -1

; the Lamplighter's welcome, heard once (it follows the pilgrim, 4 m off: talked to from there)
[node name="Conversation" parent="Machines/Lamplighter" instance=ExtResource("9_conversation")]
Lines = Array[ExtResource("90_dialogue_line")]([SubResource("Said_wake"), SubResource("Said_sea"), SubResource("Said_down")])
Range = 4.6
Once = true

[node name="Shafts" type="Node3D" parent="."]

; from the upper left onto the shrine
