[sub_resource type="Resource" id="powerup_strength_name"]
script = ExtResource("2_line")
Id = &"powerup.strength.name"
Speaker = "UI"
Text = "Strength"
Notes = "Shown as a strength power-up is taken."

[sub_resource type="Resource" id="powerup_strength_hint"]
script = ExtResource("2_line")
Id = &"powerup.strength.hint"
Speaker = "UI"
Text = "Each blow strikes harder."
Notes = "Under the name: what it does, plainly."

[sub_resource type="Resource" id="powerup_defense_name"]
script = ExtResource("2_line")
Id = &"powerup.defense.name"
Speaker = "UI"
Text = "Defense"
Notes = "Shown as a defense power-up is taken."

[sub_resource type="Resource" id="powerup_defense_hint"]
script = ExtResource("2_line")
Id = &"powerup.defense.hint"
Speaker = "UI"
Text = "The pilgrim can take one more hit."
Notes = "Under the name: what it does, plainly."

[sub_resource type="Resource" id="ui_talk"]
script = ExtResource("2_line")
Id = &"ui.talk"
Speaker = "UI"
Text = "Talk"
Notes = "The prompt over someone the pilgrim can talk to."

[sub_resource type="Resource" id="ui_pull"]
script = ExtResource("2_line")
Id = &"ui.pull"
Speaker = "UI"
Text = "Pull"
Notes = "The prompt at a lever."

[sub_resource type="Resource" id="map_gate_mechanism"]
script = ExtResource("2_line")
Id = &"map.gate.mechanism"
Speaker = "UI"
Text = "a mechanism"
Notes = "The map legend's word for a way barred by a gate on a lever."

[sub_resource type="Resource" id="ending_title"]
script = ExtResource("2_line")
Id = &"ending.title"
Speaker = "UI"
Text = "THE BEACON"
Notes = "The end card of the sequel world: its title."

[sub_resource type="Resource" id="ending_line"]
script = ExtResource("2_line")
Id = &"ending.line"
Speaker = "UI"
Text = "The lamp is cold. The sea-wall holds, and nothing comes in from the dark water."
Notes = "Under the title, quiet."

[sub_resource type="Resource" id="ending_thanks"]
script = ExtResource("2_line")
Id = &"ending.thanks"
Speaker = "UI"
Text = "The sequel test: a world built from the bricks alone. Thank you for playing."
Notes = "Last, small."

[sub_resource type="Resource" id="dialogue_quay_lamplighter_wake"]
script = ExtResource("2_line")
Id = &"dialogue.quay_lamplighter.wake"
Speaker = "Lamplighter"
Text = "Another one washed up on the quay. Still warm. Still obeying, I can hear it in you."
Notes = "Curious, kind; it circles the pilgrim."

[sub_resource type="Resource" id="dialogue_quay_lamplighter_sea"]
script = ExtResource("2_line")
Id = &"dialogue.quay_lamplighter.sea"
Speaker = "Lamplighter"
Text = "The sea froze while the keepers slept. Their locks still turn, if something climbs to them."
Notes = "Looking east, toward the Locks."

[sub_resource type="Resource" id="dialogue_quay_lamplighter_down"]
script = ExtResource("2_line")
Id = &"dialogue.quay_lamplighter.down"
Speaker = "Lamplighter"
Text = "Go on to the Beacon, little law-keeper. Someone should see it lit, or see it cold."
Notes = "A farewell; it drifts back to its post."

[sub_resource type="Resource" id="item_strongroom_key_name"]
script = ExtResource("2_line")
Id = &"item.strongroom_key.name"
Speaker = "UI"
Text = "Strongroom Key"
Notes = "Shown when taken, and on the map."

[sub_resource type="Resource" id="item_strongroom_key_taken"]
script = ExtResource("2_line")
Id = &"item.strongroom_key.taken"
Speaker = "UI"
Text = "A keeper's key, rimed with salt. A door on the quay was made for it."
Notes = "Under the name."

[sub_resource type="Resource" id="item_strongroom_key_locked"]
script = ExtResource("2_line")
Id = &"item.strongroom_key.locked"
Speaker = "Pilgrim"
Text = "A keeper's lock. The key is somewhere above."
Notes = "Said at the Strongroom door without the key."

[sub_resource type="Resource" id="item_weir_lever_name"]
script = ExtResource("2_line")
Id = &"item.weir_lever.name"
Speaker = "UI"
Text = "Sluice Gate"
Notes = "The mechanism, named on the map."

[sub_resource type="Resource" id="item_weir_lever_locked"]
script = ExtResource("2_line")
Id = &"item.weir_lever.locked"
Speaker = "Pilgrim"
Text = "The sluice gate is down. Its lever stands close by."
Notes = "Said at the gate before the lever is pulled."

[sub_resource type="Resource" id="plate_strongroom_title"]
script = ExtResource("2_line")
Id = &"plate.strongroom.title"
Speaker = "UI"
Text = "The Keepers' Plate"
Notes = "The plate in the Strongroom."

[sub_resource type="Resource" id="plate_strongroom_text"]
script = ExtResource("2_line")
Id = &"plate.strongroom.text"
Speaker = "Scripture"
Text = "We kept the wall against the sea, and the sea came in as ice. Keep what we kept: the light at the end."
Notes = "Read slowly; a duty passed on."

