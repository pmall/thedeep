[gd_resource type="Resource" script_class="LineBook" format=3]
; Every line of text in the sequel world (worlds/sequel/world.tres), as data: a stable id, the speaker, the words, delivery
; notes (docs/roadmap.md#audio). The lines the game's own screens name (ui., map., hint.gate., ability., powerup., ending.)
; are every world's to give; the creeds are those of the species its rooms place. Placeholder text.

[ext_resource type="Script" path="res://scripts/text/LineBook.cs" id="1_book"]
[ext_resource type="Script" path="res://scripts/text/TextLine.cs" id="2_line"]

[sub_resource type="Resource" id="creed_lamplighter"]
script = ExtResource("2_line")
Id = &"creed.lamplighter"
Speaker = "Lamplighter"
Text = "I do not lead. I light the way you were already walking."
Notes = "Soft, close to the ear, curious."

[sub_resource type="Resource" id="ui_rest"]
script = ExtResource("2_line")
Id = &"ui.rest"
Speaker = "UI"
Text = "Rest"
Notes = "The prompt at a pilgrim shrine."

[sub_resource type="Resource" id="ability_mag_grip_name"]
script = ExtResource("2_line")
Id = &"ability.mag_grip.name"
Speaker = "UI"
Text = "Mag-grip"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_mag_grip_hint"]
script = ExtResource("2_line")
Id = &"ability.mag_grip.hint"
Speaker = "UI"
Text = "Press into metal to walk its walls and ceilings. Jump to leap away."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="ability_harpoon_name"]
script = ExtResource("2_line")
Id = &"ability.harpoon.name"
Speaker = "UI"
Text = "Harpoon"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_harpoon_hint"]
script = ExtResource("2_line")
Id = &"ability.harpoon.hint"
Speaker = "UI"
Text = "K or V (pad B) fires at a glowing ring in sight and pulls you to it. Hold up or down to aim."
Notes = "Banner line under the title. Names the keys: the Harpoon is the first ability with its own button."

[sub_resource type="Resource" id="ability_drill_name"]
script = ExtResource("2_line")
Id = &"ability.drill.name"
Speaker = "UI"
Text = "Drill"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_drill_hint"]
script = ExtResource("2_line")
Id = &"ability.drill.hint"
Speaker = "UI"
Text = "Dash into cracked rock to bore through it. Hold down and dash to dive."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="ui_read"]
script = ExtResource("2_line")
Id = &"ui.read"
Speaker = "UI"
Text = "Read"
Notes = "The prompt at a scripture plate."

[sub_resource type="Resource" id="creed_chorister"]
script = ExtResource("2_line")
Id = &"creed.chorister"
Speaker = "Chorister"
Text = "We stopped singing when the cold came. The song did not stop. Do not wake it."
Notes = "Barely voiced, a breath through frost; many voices at once, slightly out of step."

[sub_resource type="Resource" id="ability_ballast_name"]
script = ExtResource("2_line")
Id = &"ability.ballast.name"
Speaker = "UI"
Text = "Ballast"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_ballast_hint"]
script = ExtResource("2_line")
Id = &"ability.ballast.hint"
Speaker = "UI"
Text = "In water, hold down to fill the tanks and sink. Up or jump blows them, and you rise."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="ability_heat_plating_name"]
script = ExtResource("2_line")
Id = &"ability.heat_plating.name"
Speaker = "UI"
Text = "Heat plating"
Notes = "Banner title when the relic is taken."

[sub_resource type="Resource" id="ability_heat_plating_hint"]
script = ExtResource("2_line")
Id = &"ability.heat_plating.hint"
Speaker = "UI"
Text = "Heat no longer burns you: walk through vents and slag."
Notes = "Banner line under the title."

[sub_resource type="Resource" id="hint_gate_metal"]
script = ExtResource("2_line")
Id = &"hint.gate.metal"
Speaker = "Pilgrim"
Text = "Bare metal, smooth and cold. Nothing in these hands holds to it yet."
Notes = "A gate the pilgrim cannot pass yet: pressing into a metal wall without Mag-grip. Quiet, to itself."

[sub_resource type="Resource" id="hint_gate_rings"]
script = ExtResource("2_line")
Id = &"hint.gate.rings"
Speaker = "Pilgrim"
Text = "A mooring ring, out of reach. Something could be cast to it."
Notes = "A gate the pilgrim cannot pass yet: a harpoon ring in sight without the Harpoon."

[sub_resource type="Resource" id="hint_gate_cracked"]
script = ExtResource("2_line")
Id = &"hint.gate.cracked"
Speaker = "Pilgrim"
Text = "Cracked rock. It would give to a bore."
Notes = "A gate the pilgrim cannot pass yet: against cracked rock without the Drill."

[sub_resource type="Resource" id="hint_gate_water"]
script = ExtResource("2_line")
Id = &"hint.gate.water"
Speaker = "Pilgrim"
Text = "Too light to sink. The deep water holds the pilgrim up."
Notes = "A gate the pilgrim cannot pass yet: pressing down in deep water without Ballast."

[sub_resource type="Resource" id="hint_gate_heat"]
script = ExtResource("2_line")
Id = &"hint.gate.heat"
Speaker = "Pilgrim"
Text = "The heat throws the pilgrim back. Its plating would not bear it."
Notes = "A gate the pilgrim cannot pass yet: burned by heat without Heat plating."

[sub_resource type="Resource" id="map_gate_metal"]
script = ExtResource("2_line")
Id = &"map.gate.metal"
Speaker = "UI"
Text = "metal"
Notes = "Map legend: a way that needs Mag-grip, named by what the pilgrim sees there."

[sub_resource type="Resource" id="map_gate_rings"]
script = ExtResource("2_line")
Id = &"map.gate.rings"
Speaker = "UI"
Text = "rings"
Notes = "Map legend: a way that needs the Harpoon."

[sub_resource type="Resource" id="map_gate_cracked"]
script = ExtResource("2_line")
Id = &"map.gate.cracked"
Speaker = "UI"
Text = "cracked rock"
Notes = "Map legend: a way that needs the Drill."

[sub_resource type="Resource" id="map_gate_water"]
script = ExtResource("2_line")
Id = &"map.gate.water"
Speaker = "UI"
Text = "deep water"
Notes = "Map legend: a way that needs Ballast."

[sub_resource type="Resource" id="map_gate_heat"]
script = ExtResource("2_line")
Id = &"map.gate.heat"
Speaker = "UI"
Text = "heat"
Notes = "Map legend: a way that needs Heat plating."

[sub_resource type="Resource" id="map_way_open"]
script = ExtResource("2_line")
Id = &"map.way.open"
Speaker = "UI"
Text = "a way not yet taken"
Notes = "Map legend: an exit the pilgrim can take now and has not."

[sub_resource type="Resource" id="map_way_unbuilt"]
script = ExtResource("2_line")
Id = &"map.way.unbuilt"
Speaker = "UI"
Text = "not built yet"
Notes = "Map legend: a way leading to a room not built yet (until the world is complete)."

