<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TheDeep</RootNamespace>
    <!-- Only FrameGrabber uses it: copying frames out of Godot's buffers without garbage. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The core and the xUnit tests are projects of their own; keep their sources out of the game assembly. -->
    <Compile Remove="core/**" />
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rules and state, Godot-free (instructions/principles.md#engine-detail): the game is their adapter. -->
    <ProjectReference Include="core/TheDeep.Core.csproj" />
  </ItemGroup>
</Project>
