[gd_scene format=3]
; Someone to talk to (scripts/dialogue/Conversation.cs): instance it as a child of whoever speaks, its origin at their feet (or
; where the pilgrim should stand); set Lines (and Once). "Talk" shows over it while the pilgrim may talk (the line ui.talk).

[ext_resource type="Script" path="res://scripts/dialogue/Conversation.cs" id="1_conversation"]
[ext_resource type="Script" path="res://scripts/ui/ActionPrompt.cs" id="90_prompt"]

[node name="Conversation" type="Node3D" node_paths=PackedStringArray("Prompt")]
script = ExtResource("1_conversation")
Prompt = NodePath("Prompt")

[node name="Prompt" type="Node3D" parent="."]
script = ExtResource("90_prompt")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.3, 0.6)
Verb = &"ui.talk"
