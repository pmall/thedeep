[gd_scene format=3]
; A power-up (scripts/props/PowerUp.cs): a crystal floating in the cradle of a low pedestal, glowing in its stat's color
; (PowerStats) with the cradle's rim and its light. Each stat has its own shape: strength a crown of three blades, defense a cut
; stone in two warding rings. Place it with its origin on the floor; set Stat and Amount.

[ext_resource type="Script" path="res://scripts/props/PowerUp.cs" id="1_power"]
[ext_resource type="Script" path="res://scripts/kit/ColumnMesh.cs" id="2_column"]
[ext_resource type="Material" path="res://assets/materials/stone_mid.tres" id="3_stone_mid"]
[ext_resource type="Material" path="res://assets/materials/token_glow.tres" id="4_glow"]
[ext_resource type="Script" path="res://scripts/kit/CradleMesh.cs" id="5_cradle"]
[ext_resource type="Material" path="res://assets/materials/fixture.tres" id="6_fixture"]
[ext_resource type="Script" path="res://scripts/parts/RingMesh.cs" id="7_ring"]
[ext_resource type="Script" path="res://scripts/kit/CrystalMesh.cs" id="8_crystal"]
[ext_resource type="Script" path="res://scripts/rooms/dressing/Spinner.cs" id="9_spinner"]

[sub_resource type="PrimitiveMesh" id="Pedestal"]
script = ExtResource("2_column")
Height = 0.55
Radius = 0.34
Sides = 8
Shafts = 1
Plinth = 0.18
Capital = 0.14

[sub_resource type="PrimitiveMesh" id="Cradle"]
script = ExtResource("5_cradle")
Radius = 0.24
Height = 0.32
Prongs = 3

[sub_resource type="PrimitiveMesh" id="Rim"]
script = ExtResource("7_ring")
RadiusX = 0.28
RadiusZ = 0.28
Height = 0.035
Thickness = 0.03
Segments = 28

; strength: a tall four-sided blade and two shorter ones, leaning out like a crown
[sub_resource type="PrimitiveMesh" id="Blade"]
script = ExtResource("8_crystal")
Radius = 0.1
Sides = 4
Band = 0.05
Top = 0.4
Bottom = 0.16

[sub_resource type="PrimitiveMesh" id="SideBlade"]
script = ExtResource("8_crystal")
Radius = 0.065
Sides = 4
Band = 0.03
Top = 0.25
Bottom = 0.09

; defense: a squat six-sided stone, held close in two rings (a solid stone, not an anchor's open ring)
[sub_resource type="PrimitiveMesh" id="Stone"]
script = ExtResource("8_crystal")
Radius = 0.19
Sides = 6
Band = 0.14
Top = 0.13
Bottom = 0.13

[sub_resource type="PrimitiveMesh" id="Ward"]
script = ExtResource("7_ring")
RadiusX = 0.235
RadiusZ = 0.235
Height = 0.045
Thickness = 0.028
Segments = 32

[node name="PowerUp" type="Node3D" node_paths=PackedStringArray("Token", "StrengthLook", "DefenseLook", "Glows", "Rim", "Light")]
script = ExtResource("1_power")
Token = NodePath("Token")
StrengthLook = NodePath("Token/Strength")
DefenseLook = NodePath("Token/Defense")
Glows = [NodePath("Token/Strength/BladeSpin/Blade"), NodePath("Token/Strength/LeftSpin/Left"), NodePath("Token/Strength/RightSpin/Right"), NodePath("Token/Defense/StoneSpin/Stone"), NodePath("Token/Defense/WardSpinA/WardA"), NodePath("Token/Defense/WardSpinB/WardB"), NodePath("Rim")]
Rim = NodePath("Rim")
Light = NodePath("Light")

[node name="Pedestal" type="MeshInstance3D" parent="."]
mesh = SubResource("Pedestal")
material_override = ExtResource("3_stone_mid")

; the reliquary's claws on the pedestal's top, the crystal turning between them
[node name="Cradle" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.55, 0)
mesh = SubResource("Cradle")
material_override = ExtResource("6_fixture")

; the cradle's lit rim, round the pedestal's top
[node name="Rim" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.57, 0)
mesh = SubResource("Rim")
material_override = ExtResource("4_glow")
cast_shadow = 0

[node name="Token" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.1, 0)

[node name="Strength" type="Node3D" parent="Token"]

; each blade spins about its own axis (Spinner), so its facets glint in turn
[node name="BladeSpin" type="Node3D" parent="Token/Strength"]
script = ExtResource("9_spinner")
Axis = Vector3(0, 1, 0)
Speed = 1.3

[node name="Blade" type="MeshInstance3D" parent="Token/Strength/BladeSpin"]
mesh = SubResource("Blade")
material_override = ExtResource("4_glow")
cast_shadow = 0

; leaning out 24 degrees, left and right
[node name="LeftSpin" type="Node3D" parent="Token/Strength"]
transform = Transform3D(0.9135, -0.4067, 0, 0.4067, 0.9135, 0, 0, 0, 1, -0.14, -0.07, 0)
script = ExtResource("9_spinner")
Axis = Vector3(-0.4067, 0.9135, 0)
Speed = -1.7

[node name="Left" type="MeshInstance3D" parent="Token/Strength/LeftSpin"]
mesh = SubResource("SideBlade")
material_override = ExtResource("4_glow")
cast_shadow = 0

[node name="RightSpin" type="Node3D" parent="Token/Strength"]
transform = Transform3D(0.9135, 0.4067, 0, -0.4067, 0.9135, 0, 0, 0, 1, 0.14, -0.07, 0)
script = ExtResource("9_spinner")
