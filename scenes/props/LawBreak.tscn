[gd_scene format=3]
; A law holding the pilgrim back (scripts/props/LawBreak.cs): a veil of faith glyphs standing at a lip, the
; refusal the pilgrim cannot walk through, the law's words over it, and the act that breaks it offered at the lip
; (a hold). Place the origin on the floor at the lip; set Toward to the forbidden side and the law's lines (its
; words, the pilgrim's refusal, the act, the banner). List Light in the room's GlyphLights.

[ext_resource type="Script" path="res://scripts/props/LawBreak.cs" id="1_law"]
[ext_resource type="Material" path="res://assets/materials/glyphs.tres" id="2_glyphs"]
[ext_resource type="Script" path="res://scripts/ui/ActionPrompt.cs" id="90_prompt"]

[sub_resource type="BoxShape3D" id="Wall"]
size = Vector3(0.5, 16, 4)

[sub_resource type="QuadMesh" id="Pane"]
size = Vector2(0.35, 4.5)

[node name="LawBreak" type="Node3D" node_paths=PackedStringArray("Fence", "Words", "Veil", "Light", "Prompt")]
script = ExtResource("1_law")
Fence = NodePath("Fence")
Words = NodePath("Words")
Veil = NodePath("Veil")
Light = NodePath("Light")
Prompt = NodePath("Prompt")

[node name="Fence" type="StaticBody3D" parent="."]

[node name="Shape" type="CollisionShape3D" parent="Fence"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 8, 0)
shape = SubResource("Wall")

; two panes of glyphs, either side of the play plane, so the pilgrim stands inside the veil
[node name="Veil" type="Node3D" parent="."]

[node name="Back" type="MeshInstance3D" parent="Veil"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.25, -0.7)
mesh = SubResource("Pane")
material_override = ExtResource("2_glyphs")
cast_shadow = 0

[node name="Front" type="MeshInstance3D" parent="Veil"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.25, 0.7)
mesh = SubResource("Pane")
material_override = ExtResource("2_glyphs")
cast_shadow = 0

[node name="Light" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0.9)
light_energy = 1.2
light_volumetric_fog_energy = 0.0
omni_range = 6.0

; the law's words (from the line book, in the style's WorldFont), over the lip, their edges blended smooth
; (docs/art-direction.md#stable-image) and drawn after their outline (they fade in by color, from the dark of the
; room); drawn over whatever stands before them, so no pillar or wall ever hides them; leaning to the pilgrim's side
; of the lip (X mirrored by Toward), clear of the frame of the way it bars
[node name="Words" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.5, 5.2, 0.5)
pixel_size = 0.0045
no_depth_test = true
alpha_cut = 0
render_priority = 1
modulate = Color(0.12, 0.11, 0.16, 1)
outline_modulate = Color(0.05, 0.04, 0.08, 1)
font_size = 56
outline_size = 10
width = 1400.0
autowrap_mode = 3

; the act, offered at the lip once the pilgrim has said why it may not: a hold of HoldSeconds breaks the law (its
; verb is the law's ActLine; it reaches away from the veil on the pilgrim's side, X mirrored by Toward)
[node name="Prompt" type="Node3D" parent="."]
script = ExtResource("90_prompt")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.35, 2.7, 0.6)
HoldSeconds = 1.5
