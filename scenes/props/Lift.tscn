[gd_scene format=3]
; A counterweighted lift (scripts/props/Lift.cs): an iron cage 3 m wide on a rope over a sheave, an iron weight on the
; rope's other end, behind the play plane. Place its origin on the top of the cage floor, centered, at the lower stop;
; set Rise. The weight hangs 5.5 m east of the cage and 2.5 m back; keep the shaft clear for it and for the cage's
; crown (3.6 m over its floor). Lamps lists Cage/Lamp to take the biome's lamp color.

[ext_resource type="Script" path="res://scripts/props/Lift.cs" id="1_lift"]
[ext_resource type="Script" path="res://scripts/kit/BlockMesh.cs" id="2_blockmesh"]
[ext_resource type="Script" path="res://scripts/kit/GrateMesh.cs" id="3_grate"]
[ext_resource type="Script" path="res://scripts/parts/RingMesh.cs" id="4_ring"]
[ext_resource type="Material" path="res://assets/materials/rust.tres" id="5_rust"]
[ext_resource type="Material" path="res://assets/materials/rust_mid.tres" id="6_rust_mid"]
[ext_resource type="Material" path="res://assets/materials/cable.tres" id="7_cable"]
[ext_resource type="Material" path="res://assets/materials/metal_mid.tres" id="8_metal_mid"]

[sub_resource type="BoxShape3D" id="Floor"]
size = Vector3(3, 0.5, 4)

[sub_resource type="PrimitiveMesh" id="Plate"]
script = ExtResource("2_blockmesh")
Size = Vector3(3, 0.5, 3)
Bevel = 0.06

