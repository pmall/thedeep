Bevel = 0.06

[sub_resource type="PrimitiveMesh" id="Yoke"]
script = ExtResource("2_blockmesh")
Size = Vector3(0.9, 0.4, 0.5)
Bevel = 0.08

[sub_resource type="PrimitiveMesh" id="Bars"]
script = ExtResource("3_grate")
Size = Vector3(2.8, 0.12, 3.2)
Spacing = 0.32
Bar = 0.05

[sub_resource type="PrimitiveMesh" id="WeightBody"]
script = ExtResource("2_blockmesh")
Size = Vector3(2.2, 4, 1.4)
Bevel = 0.12

[sub_resource type="PrimitiveMesh" id="WeightBand"]
script = ExtResource("2_blockmesh")
Size = Vector3(2.4, 0.3, 1.6)
Bevel = 0.06

[sub_resource type="PrimitiveMesh" id="Wheel"]
script = ExtResource("4_ring")
RadiusX = 3
RadiusZ = 3
Height = 0.35
Thickness = 0.28
Segments = 48

[sub_resource type="PrimitiveMesh" id="Spoke"]
script = ExtResource("2_blockmesh")
Size = Vector3(5.8, 0.18, 0.18)
Bevel = 0.03

[sub_resource type="PrimitiveMesh" id="Hub"]
script = ExtResource("2_blockmesh")
Size = Vector3(0.6, 0.6, 0.6)
Bevel = 0.1

[sub_resource type="CylinderMesh" id="Rope"]
top_radius = 0.05
bottom_radius = 0.05
height = 1.0
radial_segments = 6
rings = 1

[node name="Lift" type="Node3D" node_paths=PackedStringArray("Cage", "Weight", "SheaveMount", "Sheave", "CageRope", "WeightRope")]
script = ExtResource("1_lift")
Cage = NodePath("Cage")
Weight = NodePath("Weight")
SheaveMount = NodePath("SheaveMount")
Sheave = NodePath("SheaveMount/Sheave")
CageRope = NodePath("CageRope")
WeightRope = NodePath("WeightRope")

