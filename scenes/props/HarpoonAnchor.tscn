[gd_scene format=3]
; A harpoon anchor (scripts/props/HarpoonAnchor.cs): an iron mooring ring hung by its shackle from a short rod, a hoop lit in
; the Harpoon's color set in it, the sight's marks round it. The origin is the ring's middle, the point the pilgrim's center is
; pulled to: place it in open air, at least a body's height below any ceiling. The rod reaches 1.45 m up; hang it under a
; beam, or add a cable above it.

[ext_resource type="Script" path="res://scripts/props/HarpoonAnchor.cs" id="1_anchor"]
[ext_resource type="Script" path="res://scripts/kit/MooringRingMesh.cs" id="2_mooring"]
[ext_resource type="Script" path="res://scripts/kit/HoopMesh.cs" id="3_hoop"]
[ext_resource type="Script" path="res://scripts/kit/SightMesh.cs" id="4_sight"]
