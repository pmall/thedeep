[gd_scene format=3]
; The atmosphere stack every room shares (scripts/rooms/RoomStage.cs): environment, key light,
; skylines, the architecture in the haze, framing foreground and dust, sized from the room's bounds. A room instances
; it as "Stage" and overrides only its choices (pillar density, frame, dust, seed); the skylines are the biome's.

[ext_resource type="Script" path="res://scripts/rooms/RoomStage.cs" id="1_stage"]
[ext_resource type="Environment" path="res://resources/stage/room_environment.tres" id="2_env"]
[ext_resource type="Material" path="res://assets/materials/architecture_stone.tres" id="6_stone"]
[ext_resource type="Material" path="res://assets/materials/foreground.tres" id="7_fore"]
[ext_resource type="PackedScene" path="res://scenes/fx/Dust.tscn" id="8_dust"]
[ext_resource type="Material" path="res://assets/materials/architecture_metal.tres" id="9_metal"]
[ext_resource type="Material" path="res://assets/materials/architecture_glow.tres" id="10_glow"]
[ext_resource type="Material" path="res://assets/materials/architecture_ice.tres" id="11_ice"]
[ext_resource type="Material" path="res://assets/materials/light_shaft.tres" id="12_shaft"]

[node name="RoomStage" type="Node3D" node_paths=PackedStringArray("Environment", "KeyLight")]
script = ExtResource("1_stage")
Environment = NodePath("WorldEnvironment")
KeyLight = NodePath("Sun")
PillarMaterial = ExtResource("6_stone")
ArchitectureMetal = ExtResource("9_metal")
ArchitectureGlow = ExtResource("10_glow")
ArchitectureIce = ExtResource("11_ice")
FrameMaterial = ExtResource("7_fore")
Dust = ExtResource("8_dust")
ShaftMaterial = ExtResource("12_shaft")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_env")

; from the upper front left, so block faces facing the camera are lit and tops catch the light
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.6644, 0.5972, -0.4494, -0, 0.6013, 0.799, 0.7474, -0.5308, 0.3995, 0, 20, 10)
light_color = Color(0.72, 0.86, 0.9, 1)
light_energy = 0.9
shadow_enabled = true
