[gd_scene format=3]
; Drops falling from a ceiling or beam. Place it at the drip line, set Extents (flat in Y) and Amount;
; set the lifetime to the fall time, sqrt(2 * height / 9.8) seconds, so drops end at the floor.

[ext_resource type="Script" path="res://scripts/rooms/AmbientParticles.cs" id="1_ambient"]
[ext_resource type="Material" path="res://assets/particles/drip_process.tres" id="2_process"]
[ext_resource type="Material" path="res://assets/particles/drip_material.tres" id="3_material"]

[sub_resource type="QuadMesh" id="QuadMesh_streak"]
material = ExtResource("3_material")
size = Vector2(0.025, 0.3)

[node name="Drips" type="GPUParticles3D"]
cast_shadow = 0
amount = 12
lifetime = 2.0
process_material = ExtResource("2_process")
draw_pass_1 = SubResource("QuadMesh_streak")
script = ExtResource("1_ambient")
Drift = Vector3(0.5, 25, 0.5)
