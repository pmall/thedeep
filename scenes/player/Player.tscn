[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/player/Player.cs" id="1_player"]
[ext_resource type="Resource" path="res://resources/player_tuning.tres" id="2_tuning"]
[ext_resource type="Script" path="res://scripts/player/PlayerVisual.cs" id="3_visual"]
[ext_resource type="PackedScene" path="res://assets/pilgrim/pilgrim.glb" id="5_model"]
[ext_resource type="Material" path="res://assets/materials/pilgrim/blade.tres" id="14_blade"]
[ext_resource type="Script" path="res://scripts/player/PlayerEffects.cs" id="6_effects"]
[ext_resource type="Script" path="res://scripts/player/BurstPool.cs" id="7_pool"]
[ext_resource type="Script" path="res://scripts/player/DashTrail.cs" id="8_trail"]
[ext_resource type="PackedScene" path="res://scenes/fx/Grit.tscn" id="9_grit"]
[ext_resource type="PackedScene" path="res://scenes/fx/Puff.tscn" id="10_puff"]
[ext_resource type="PackedScene" path="res://scenes/fx/Sparks.tscn" id="11_sparks"]
[ext_resource type="Material" path="res://assets/materials/pilgrim/dash_trail.tres" id="12_trail_material"]
[ext_resource type="Script" path="res://scripts/combat/PlayerAttack.cs" id="13_attack"]
[ext_resource type="Material" path="res://assets/materials/pilgrim/slash.tres" id="15_slash"]
[ext_resource type="Script" path="res://scripts/player/SlashTrail.cs" id="16_slash_trail"]
[ext_resource type="Script" path="res://scripts/look/ToonLook.cs" id="17_toon"]
[ext_resource type="Shader" path="res://assets/shaders/android.gdshader" id="18_android"]
[ext_resource type="Shader" path="res://assets/shaders/android_toon.gdshader" id="19_android_toon"]
[ext_resource type="Material" path="res://assets/materials/looks/ink.tres" id="20_ink"]
[ext_resource type="Shader" path="res://assets/shaders/rock.gdshader" id="30_band_rock"]
[ext_resource type="Shader" path="res://assets/shaders/basalt.gdshader" id="36_band_basalt"]
[ext_resource type="Shader" path="res://assets/shaders/cracked.gdshader" id="37_band_cracked"]
[ext_resource type="Shader" path="res://assets/shaders/metal.gdshader" id="31_band_metal"]
[ext_resource type="Shader" path="res://assets/shaders/architecture.gdshader" id="32_band_architecture"]
[ext_resource type="Shader" path="res://assets/shaders/biome_surface.gdshader" id="33_band_biome_surface"]
[ext_resource type="Shader" path="res://assets/shaders/ice.gdshader" id="34_band_ice"]
[ext_resource type="Shader" path="res://assets/shaders/machine.gdshader" id="35_band_machine"]

; Sized and placed over the feet from the tuning's body (Player._Ready).
[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]

; A short pale blade, pointed (docs/art-direction.md#strikes).
[sub_resource type="PrismMesh" id="PrismMesh_blade"]
material = ExtResource("14_blade")
size = Vector3(0.045, 0.55, 0.01)

[node name="Player" type="CharacterBody3D" node_paths=PackedStringArray("Visual", "Attack", "Collision")]
collision_layer = 4
collision_mask = 3
axis_lock_linear_z = true
floor_snap_length = 0.25
script = ExtResource("1_player")
Tuning = ExtResource("2_tuning")
Visual = NodePath("Visual")
Attack = NodePath("Attack")
Collision = NodePath("Collision")

[node name="Collision" type="CollisionShape3D" parent="."]
shape = SubResource("CapsuleShape3D_body")

; The pilgrim's body: the model built in Blender, played by PlayerVisual (its blade too, and the slash it leaves).
[node name="Visual" type="Node3D" parent="." node_paths=PackedStringArray("Clips", "Tree", "Skeleton", "Mesh", "Shoulder", "Blade", "Aim", "ReachTarget", "Slash")]
script = ExtResource("3_visual")
Clips = NodePath("Model/AnimationPlayer")
Tree = NodePath("Tree")
Skeleton = NodePath("Model/Pilgrim/Skeleton3D")
Mesh = NodePath("Model/Pilgrim/Skeleton3D/Body")
Shoulder = NodePath("Shoulder")
Blade = NodePath("Forearm/Blade")
Aim = NodePath("Model/Pilgrim/Skeleton3D/Aim")
ReachTarget = NodePath("ReachTarget")
Slash = NodePath("Slash")

; The model faces +Z: turned to face +X, its right side (the blade's arm) toward the camera.
[node name="Model" parent="Visual" instance=ExtResource("5_model")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 0, 0, 0)

; Aims the near arm along the Harpoon's line (its bone points down its +Y), after the clips are applied.
[node name="Aim" type="LookAtModifier3D" parent="Visual/Model/Pilgrim/Skeleton3D"]
bone_name = "RightUpperArm"
forward_axis = 2
target_node = NodePath("../../../../ReachTarget")
influence = 0.0

[node name="ReachTarget" type="Marker3D" parent="Visual"]

; Built by PlayerVisual from the model's clips.
[node name="Tree" type="AnimationTree" parent="Visual"]
root_node = NodePath("../Model")
anim_player = NodePath("../Model/AnimationPlayer")

[node name="Shoulder" type="BoneAttachment3D" parent="Visual"]
bone_name = "RightUpperArm"
use_external_skeleton = true
external_skeleton = NodePath("../Model/Pilgrim/Skeleton3D")

[node name="Forearm" type="BoneAttachment3D" parent="Visual"]
bone_name = "RightLowerArm"
use_external_skeleton = true
external_skeleton = NodePath("../Model/Pilgrim/Skeleton3D")

; The blade springs from the wrist along the forearm: its -Y is the bone's +Y.
[node name="Blade" type="Node3D" parent="Visual/Forearm"]
transform = Transform3D(-1, 0, 0, 0, -1, 0, 0, 0, 1, 0, 0.2, 0)

; Point down, from the blade's base to its tip.
[node name="Edge" type="MeshInstance3D" parent="Visual/Forearm/Blade"]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, -0.275, 0)
cast_shadow = 0
mesh = SubResource("PrismMesh_blade")

; At the hip, toward the camera. Warm and soft, no shadow: it keeps the pilgrim and its surroundings readable in dark rooms.
[node name="CarriedLight" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.95, 0.3)
light_color = Color(1, 0.88, 0.72, 1)
light_energy = 0.6
light_specular = 0.3
omni_range = 3.5
omni_attenuation = 1.4

; Drawn in the world, just in front of the body (SlashTrail).
[node name="Slash" type="MeshInstance3D" parent="Visual"]
material_override = ExtResource("15_slash")
script = ExtResource("16_slash_trail")

; The body's center: where the dash trail is drawn from.
[node name="TrailAnchor" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.1, 0)

; Movement feedback: footstep grit and sparks, landing and dash dust, the dash trail.
[node name="Effects" type="Node" parent="." node_paths=PackedStringArray("Player", "Grit", "Puff", "Sparks", "Trail", "TrailAnchor")]
script = ExtResource("6_effects")
Player = NodePath("..")
Grit = NodePath("Grit")
Puff = NodePath("Puff")
Sparks = NodePath("Sparks")
Trail = NodePath("DashTrail")
TrailAnchor = NodePath("../TrailAnchor")

[node name="Grit" type="Node3D" parent="Effects"]
script = ExtResource("7_pool")
Effect = ExtResource("9_grit")
Count = 4

[node name="Puff" type="Node3D" parent="Effects"]
script = ExtResource("7_pool")
Effect = ExtResource("10_puff")
Count = 2

[node name="Sparks" type="Node3D" parent="Effects"]
script = ExtResource("7_pool")
Effect = ExtResource("11_sparks")
Count = 4

[node name="DashTrail" type="MeshInstance3D" parent="Effects"]
material_override = ExtResource("12_trail_material")
script = ExtResource("8_trail")

; The strikes (attack): times them, has the body show them, reports the area each hits (the machine director resolves hits).
[node name="Attack" type="Node3D" parent="." node_paths=PackedStringArray("Player")]
script = ExtResource("13_attack")
Player = NodePath("..")

; The cartoon look, off unless switched on (F9 cycles its presets in debug builds, `--look <name>` at launch): a layer over the body, removable whole.
[node name="Look" type="Node" parent="Visual" node_paths=PackedStringArray("Figure", "Poses")]
script = ExtResource("17_toon")
Figure = NodePath("..")
Poses = NodePath("..")
From = ExtResource("18_android")
To = ExtResource("19_android_toon")
Ink = ExtResource("20_ink")
Banded = [ExtResource("30_band_rock"), ExtResource("36_band_basalt"), ExtResource("37_band_cracked"), ExtResource("31_band_metal"), ExtResource("32_band_architecture"), ExtResource("33_band_biome_surface"), ExtResource("34_band_ice"), ExtResource("35_band_machine")]
