[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/player/Player.cs" id="1_player"]
[ext_resource type="Resource" path="res://resources/player_tuning.tres" id="2_tuning"]
[ext_resource type="Script" path="res://scripts/player/PlayerVisual.cs" id="3_visual"]
[ext_resource type="Script" path="res://scripts/parts/PartBody.cs" id="4_body"]
[ext_resource type="Resource" path="res://resources/parts/pilgrim.tres" id="5_pilgrim"]
[ext_resource type="Script" path="res://scripts/player/PlayerEffects.cs" id="6_effects"]
[ext_resource type="Script" path="res://scripts/player/BurstPool.cs" id="7_pool"]
[ext_resource type="Script" path="res://scripts/player/DashTrail.cs" id="8_trail"]
[ext_resource type="PackedScene" path="res://scenes/fx/Grit.tscn" id="9_grit"]
[ext_resource type="PackedScene" path="res://scenes/fx/Puff.tscn" id="10_puff"]
[ext_resource type="PackedScene" path="res://scenes/fx/Sparks.tscn" id="11_sparks"]
[ext_resource type="Material" path="res://assets/materials/pilgrim/dash_trail.tres" id="12_trail_material"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.35
height = 1.6

[node name="Player" type="CharacterBody3D" node_paths=PackedStringArray("Visual")]
collision_layer = 4
collision_mask = 3
axis_lock_linear_z = true
floor_snap_length = 0.25
script = ExtResource("1_player")
Tuning = ExtResource("2_tuning")
Visual = NodePath("Visual")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
shape = SubResource("CapsuleShape3D_body")

; The pilgrim's body: parts from resources/parts/pilgrim.tres, animated by PlayerVisual.
[node name="Visual" type="Node3D" parent="." node_paths=PackedStringArray("Body", "CarriedLight")]
script = ExtResource("3_visual")
Body = NodePath("Body")
CarriedLight = NodePath("CarriedLight")

[node name="Body" type="Node3D" parent="Visual"]
script = ExtResource("4_body")
Assembly = ExtResource("5_pilgrim")

; Moves into the lantern on ready (position = offset from the lantern's top). Warm and soft, no shadow:
; it keeps the pilgrim and its surroundings readable in dark rooms.
[node name="CarriedLight" type="OmniLight3D" parent="Visual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.06, 0)
light_color = Color(1, 0.88, 0.72, 1)
light_energy = 0.6
light_specular = 0.3
omni_range = 3.5
omni_attenuation = 1.4

; The body's center: where the dash trail is drawn from.
[node name="TrailAnchor" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.1, 0)

; Movement feedback: footstep grit and sparks, landing and dash dust, the dash trail.
[node name="Effects" type="Node" parent="." node_paths=PackedStringArray("Player", "Grit", "Puff", "Sparks", "Trail", "TrailAnchor")]
script = ExtResource("6_effects")
Player = NodePath("..")
Grit = NodePath("Grit")
Puff = NodePath("Puff")
Sparks = NodePath("Sparks")
Trail = NodePath("DashTrail")
TrailAnchor = NodePath("../TrailAnchor")

[node name="Grit" type="Node3D" parent="Effects"]
script = ExtResource("7_pool")
Effect = ExtResource("9_grit")
Count = 4

[node name="Puff" type="Node3D" parent="Effects"]
script = ExtResource("7_pool")
Effect = ExtResource("10_puff")
Count = 2

[node name="Sparks" type="Node3D" parent="Effects"]
script = ExtResource("7_pool")
Effect = ExtResource("11_sparks")
Count = 4

[node name="DashTrail" type="MeshInstance3D" parent="Effects"]
material_override = ExtResource("12_trail_material")
script = ExtResource("8_trail")
