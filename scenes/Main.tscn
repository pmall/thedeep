[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Main.cs" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/rooms/TestRoom.tscn" id="2_room"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/DebugHud.tscn" id="4_hud"]
[ext_resource type="Script" path="res://scripts/debug/DebugCheats.cs" id="5_cheats"]
[ext_resource type="PackedScene" path="res://scenes/camera/SideCamera.tscn" id="6_camera"]

[node name="Main" type="Node3D" node_paths=PackedStringArray("Room", "Player")]
script = ExtResource("1_main")
Room = NodePath("TestRoom")
Player = NodePath("Player")

[node name="TestRoom" parent="." instance=ExtResource("2_room")]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="SideCamera" parent="." node_paths=PackedStringArray("Target", "Room") instance=ExtResource("6_camera")]
Target = NodePath("../Player")
Room = NodePath("../TestRoom")

[node name="DebugHud" parent="." node_paths=PackedStringArray("Player") instance=ExtResource("4_hud")]
Player = NodePath("../Player")

[node name="DebugCheats" type="Node" parent="." node_paths=PackedStringArray("Player", "Room")]
script = ExtResource("5_cheats")
Player = NodePath("../Player")
