[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Main.cs" id="1_main"]
[ext_resource type="Script" path="res://scripts/rooms/World.cs" id="2_world"]
[ext_resource type="Resource" path="res://worlds/prototype/world.tres" id="2_definition"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/DebugHud.tscn" id="4_hud"]
[ext_resource type="Script" path="res://scripts/debug/DebugCheats.cs" id="5_cheats"]
[ext_resource type="PackedScene" path="res://scenes/camera/SideCamera.tscn" id="6_camera"]
[ext_resource type="PackedScene" path="res://scenes/ui/OwnerCapture.tscn" id="7_capture"]
[ext_resource type="PackedScene" path="res://scenes/camera/ScreenGrade.tscn" id="10_grade"]
[ext_resource type="Script" path="res://scripts/machines/MachineDirector.cs" id="11_machines"]
[ext_resource type="Script" path="res://scripts/player/BurstPool.cs" id="12_pool"]
[ext_resource type="PackedScene" path="res://scenes/fx/Sparks.tscn" id="13_sparks"]
[ext_resource type="Script" path="res://scripts/rooms/RoomTravel.cs" id="14_travel"]
[ext_resource type="Script" path="res://scripts/ui/ScreenFade.cs" id="15_fade"]
[ext_resource type="Script" path="res://scripts/ui/MapScreen.cs" id="16_map"]
[ext_resource type="Script" path="res://scripts/game/Session.cs" id="17_session"]
[ext_resource type="Script" path="res://scripts/ui/HealthHud.cs" id="18_health"]
[ext_resource type="Script" path="res://scripts/ui/Banner.cs" id="19_banner"]
[ext_resource type="Script" path="res://scripts/player/HarpoonRig.cs" id="20_harpoon"]
[ext_resource type="Material" path="res://assets/materials/harpoon_line.tres" id="21_line"]
[ext_resource type="Script" path="res://scripts/game/GateHints.cs" id="22_gates"]
[ext_resource type="Script" path="res://scripts/ui/HintLine.cs" id="23_hint"]
[ext_resource type="Script" path="res://scripts/ui/EndCard.cs" id="24_end"]
[ext_resource type="CompositorEffect" path="res://resources/stage/paint_pass.tres" id="25_paint"]
[ext_resource type="Resource" path="res://resources/paint/gouache.tres" id="26_gouache"]
[ext_resource type="Resource" path="res://resources/paint/poster.tres" id="27_poster"]
[ext_resource type="Resource" path="res://resources/paint/scripture.tres" id="28_scripture"]
[ext_resource type="Script" path="res://scripts/game/Keyring.cs" id="29_keyring"]
[ext_resource type="Script" path="res://scripts/ui/AnchorPointer.cs" id="30_pointer"]
[ext_resource type="Script" path="res://scripts/game/PowerUps.cs" id="30_powerups"]
[ext_resource type="Script" path="res://scripts/dialogue/Conversations.cs" id="31_conversations"]
[ext_resource type="Script" path="res://scripts/ui/DialogueBox.cs" id="32_dialogue_box"]
[ext_resource type="Script" path="res://scripts/game/Arenas.cs" id="33_arenas"]
[ext_resource type="Script" path="res://scripts/game/Secrets.cs" id="34_secrets"]

[sub_resource type="CylinderMesh" id="HarpoonLine"]
top_radius = 0.016
bottom_radius = 0.016
height = 1.0
radial_segments = 6
rings = 1
cap_top = false
cap_bottom = false

[sub_resource type="CylinderMesh" id="HarpoonHead"]
top_radius = 0.0
bottom_radius = 0.06
height = 0.3
radial_segments = 8
rings = 1

[node name="Main" type="Node3D" node_paths=PackedStringArray("World", "Player", "Machines", "Capture", "Camera", "Hud", "Travel", "Session", "Health", "Hint", "MapScreen", "Hints", "Keyring", "PowerUps", "Conversations", "DialogueBox", "Secrets", "Pointer")]
script = ExtResource("1_main")
World = NodePath("World")
Player = NodePath("Player")
Machines = NodePath("Machines")
Capture = NodePath("OwnerCapture")
Camera = NodePath("SideCamera")
Hud = NodePath("DebugHud")
Travel = NodePath("RoomTravel")
Session = NodePath("Session")
Health = NodePath("HealthHud")
Hint = NodePath("HintLine")
Pointer = NodePath("AnchorPointer")
MapScreen = NodePath("MapScreen")
Hints = NodePath("GateHints")
Keyring = NodePath("Keyring")
PowerUps = NodePath("PowerUps")
Conversations = NodePath("Conversations")
DialogueBox = NodePath("DialogueBox")
Secrets = NodePath("Secrets")
Paint = ExtResource("25_paint")

; Loads the room scenes of its world (first child, so the room exists before the camera and HUD are ready). The world
; played unless `--world` picks another: the prototype.
[node name="World" type="Node3D" parent="."]
script = ExtResource("2_world")
Definition = ExtResource("2_definition")

[node name="Player" parent="." instance=ExtResource("3_player")]

; The Harpoon: picks the anchor in sight each tick (after the player moved) and draws the line.
[node name="Harpoon" type="Node3D" parent="." node_paths=PackedStringArray("World", "Player", "Line", "Head")]
script = ExtResource("20_harpoon")
World = NodePath("../World")
Player = NodePath("../Player")
Line = NodePath("Line")
Head = NodePath("Head")

[node name="Line" type="MeshInstance3D" parent="Harpoon"]
mesh = SubResource("HarpoonLine")
material_override = ExtResource("21_line")
cast_shadow = 0

[node name="Head" type="MeshInstance3D" parent="Harpoon"]
mesh = SubResource("HarpoonHead")
material_override = ExtResource("21_line")
cast_shadow = 0

; Runs the room's machines: their perception (player, impacts, neighbors) and their physics ticks.
[node name="Machines" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "HitSparks", "Camera")]
script = ExtResource("11_machines")
World = NodePath("../World")
Player = NodePath("../Player")
HitSparks = NodePath("HitSparks")
Camera = NodePath("../SideCamera")

[node name="HitSparks" type="Node3D" parent="Machines"]
script = ExtResource("12_pool")
Effect = ExtResource("13_sparks")
Count = 3

; Moves the player between rooms through their exits, under a short fade.
[node name="RoomTravel" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Fade")]
script = ExtResource("14_travel")
World = NodePath("../World")
Player = NodePath("../Player")
Fade = NodePath("../ScreenFade")

; Shrines (rest: heal and save), relics, death and the return to the last shrine, the save.
[node name="Session" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Fade", "Banner", "Camera", "EndCard", "Travel")]
script = ExtResource("17_session")
World = NodePath("../World")
Player = NodePath("../Player")
Fade = NodePath("../ScreenFade")
Banner = NodePath("../Banner")
Camera = NodePath("../SideCamera")
EndCard = NodePath("../EndCard")
Travel = NodePath("../RoomTravel")

; A gate the pilgrim can't pass yet says so: its line, low on the screen.
; The items and the doors they open (Keyring): taking keys and codes, opening locked doors, the line at a door without its item.
[node name="Keyring" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Session", "Banner", "Hint", "Camera", "Travel")]
script = ExtResource("29_keyring")
World = NodePath("../World")
Player = NodePath("../Player")
Session = NodePath("../Session")
Banner = NodePath("../Banner")
Hint = NodePath("../HintLine")
Camera = NodePath("../SideCamera")
Travel = NodePath("../RoomTravel")

; The power-ups (PowerUps): taking them, the stat they raise.
[node name="PowerUps" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Session", "Banner")]
script = ExtResource("30_powerups")
World = NodePath("../World")
Player = NodePath("../Player")
Session = NodePath("../Session")
Banner = NodePath("../Banner")

; The conversations (Conversations): talking to someone, their lines in the dialogue box.
[node name="Conversations" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Session", "Box")]
script = ExtResource("31_conversations")
World = NodePath("../World")
Player = NodePath("../Player")
Session = NodePath("../Session")
Box = NodePath("../DialogueBox")

; The sealed arenas (Arenas): a boss's and an ambush's, handed the pilgrim, settled, remembered.
[node name="Arenas" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Session", "Banner", "Camera")]
script = ExtResource("33_arenas")
World = NodePath("../World")
Player = NodePath("../Player")
Session = NodePath("../Session")
Banner = NodePath("../Banner")
Camera = NodePath("../SideCamera")

; The hidden passages (Secrets): false walls found by walking into them, remembered.
[node name="Secrets" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Session")]
script = ExtResource("34_secrets")
World = NodePath("../World")
Player = NodePath("../Player")
Session = NodePath("../Session")

[node name="GateHints" type="Node" parent="." node_paths=PackedStringArray("World", "Player", "Harpoon", "Hint")]
script = ExtResource("22_gates")
World = NodePath("../World")
Player = NodePath("../Player")
Harpoon = NodePath("../Harpoon")
Hint = NodePath("../HintLine")

[node name="SideCamera" parent="." node_paths=PackedStringArray("Target", "World") instance=ExtResource("6_camera")]
Target = NodePath("../Player")
World = NodePath("../World")
Paint = ExtResource("25_paint")

[node name="ScreenGrade" parent="." instance=ExtResource("10_grade")]

[node name="ScreenFade" type="CanvasLayer" parent="."]
script = ExtResource("15_fade")

[node name="HealthHud" type="CanvasLayer" parent="." node_paths=PackedStringArray("Player")]
script = ExtResource("18_health")
Player = NodePath("../Player")

; points at the Harpoon's target when the camera doesn't frame it
[node name="AnchorPointer" type="CanvasLayer" parent="." node_paths=PackedStringArray("Player", "Camera")]
script = ExtResource("30_pointer")
Player = NodePath("../Player")
Camera = NodePath("../SideCamera")

[node name="Banner" type="CanvasLayer" parent="."]
script = ExtResource("19_banner")

[node name="DialogueBox" type="CanvasLayer" parent="."]
script = ExtResource("32_dialogue_box")

[node name="EndCard" type="CanvasLayer" parent="."]
script = ExtResource("24_end")

[node name="HintLine" type="CanvasLayer" parent="."]
script = ExtResource("23_hint")

[node name="MapScreen" type="CanvasLayer" parent="." node_paths=PackedStringArray("World", "Player")]
script = ExtResource("16_map")
World = NodePath("../World")
Player = NodePath("../Player")

[node name="DebugHud" parent="." node_paths=PackedStringArray("Player", "World") instance=ExtResource("4_hud")]
Player = NodePath("../Player")
World = NodePath("../World")

; F9 cycles the paint: the biome's own, each variant here, then none.
[node name="DebugCheats" type="Node" parent="." node_paths=PackedStringArray("Player", "World")]
script = ExtResource("5_cheats")
Player = NodePath("../Player")
World = NodePath("../World")
Paint = ExtResource("25_paint")
PaintVariants = [ExtResource("26_gouache"), ExtResource("27_poster"), ExtResource("28_scripture")]

[node name="OwnerCapture" parent="." node_paths=PackedStringArray("Player", "World") instance=ExtResource("7_capture")]
Player = NodePath("../Player")
World = NodePath("../World")
