<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain xUnit tests for pure game logic. Godot types can't run outside the engine, so this
       project compiles the Godot-free source files directly instead of referencing TheDeep.csproj. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>TheDeep.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep in sync with the "Pure logic" list in docs/architecture.md. These files must not use Godot types. -->
    <Compile Include="../../scripts/util/Motion.cs" Link="Shared/Motion.cs" />
    <Compile Include="../../scripts/util/Countdown.cs" Link="Shared/Countdown.cs" />
    <Compile Include="../../scripts/tuning/JumpMath.cs" Link="Shared/JumpMath.cs" />
    <Compile Include="../../scripts/camera/CameraMath.cs" Link="Shared/CameraMath.cs" />
    <Compile Include="../../scripts/abilities/Ability.cs" Link="Shared/Ability.cs" />
    <Compile Include="../../scripts/abilities/AbilitySet.cs" Link="Shared/AbilitySet.cs" />
    <Compile Include="../../scripts/util/FrameTimeStats.cs" Link="Shared/FrameTimeStats.cs" />
    <Compile Include="../../scripts/capture/CaptureFiles.cs" Link="Shared/CaptureFiles.cs" />
    <Compile Include="../../scripts/capture/CaptureReport.cs" Link="Shared/CaptureReport.cs" />
    <Compile Include="../../scripts/capture/VideoClock.cs" Link="Shared/VideoClock.cs" />
    <Compile Include="../../scripts/capture/FfmpegCommand.cs" Link="Shared/FfmpegCommand.cs" />
    <Compile Include="../../scripts/capture/VideoEncoder.cs" Link="Shared/VideoEncoder.cs" />
    <Compile Include="../../scripts/kit/MeshData.cs" Link="Shared/MeshData.cs" />
    <Compile Include="../../scripts/kit/MeshBuilder.cs" Link="Shared/MeshBuilder.cs" />
    <Compile Include="../../scripts/kit/Profile.cs" Link="Shared/Profile.cs" />
    <Compile Include="../../scripts/kit/PathFrame.cs" Link="Shared/PathFrame.cs" />
    <Compile Include="../../scripts/kit/SweepPath.cs" Link="Shared/SweepPath.cs" />
    <Compile Include="../../scripts/kit/KitShapes.cs" Link="Shared/KitShapes.cs" />
    <Compile Include="../../scripts/map/Requirement.cs" Link="Shared/Requirement.cs" />
    <Compile Include="../../scripts/map/GridSnap.cs" Link="Shared/GridSnap.cs" />
    <Compile Include="../../scripts/parts/PartShapes.cs" Link="Shared/PartShapes.cs" />
    <Compile Include="../../scripts/parts/PlanarIk.cs" Link="Shared/PlanarIk.cs" />
    <Compile Include="../../scripts/parts/VerletChain.cs" Link="Shared/VerletChain.cs" />
    <Compile Include="../../scripts/parts/HumanoidBone.cs" Link="Shared/HumanoidBone.cs" />
    <Compile Include="../../scripts/parts/Humanoid.cs" Link="Shared/Humanoid.cs" />
    <Compile Include="../../scripts/parts/HumanoidDims.cs" Link="Shared/HumanoidDims.cs" />
    <Compile Include="../../scripts/parts/HumanoidPose.cs" Link="Shared/HumanoidPose.cs" />
    <Compile Include="../../scripts/parts/PartCategory.cs" Link="Shared/PartCategory.cs" />
    <Compile Include="../../scripts/player/MotionMode.cs" Link="Shared/MotionMode.cs" />
    <Compile Include="../../scripts/player/PilgrimMotion.cs" Link="Shared/PilgrimMotion.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
