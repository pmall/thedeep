<Project>
  <!-- Shared by the game, the core and the tests (instructions/testing.md#check): the code style rules of .editorconfig are
       enforced by the build, and the SDK's Recommended set of analyzers runs on all three (the rules turned off, each
       with its reason, are in .editorconfig), so a style or analyzer warning fails it like any other
       (TreatWarningsAsErrors, in each project). -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- IDE0005 (unused usings) only runs in a build when the documentation file is generated, which also switches on the
         XML doc checks. The ones that catch a doc contradicting the code stay on (CS1574 and CS0419 a cref that does not
         resolve, CS1734 a paramref to a missing parameter). Two stay off because they demand boilerplate, and docblocks are
         prose (instructions/principles.md#small-readable, AGENTS.md#doc-rules): CS1591 (every public member documented)
         and CS1573 (every parameter tagged once one is, which records' positional parameters, described in the summary,
         never satisfy). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
