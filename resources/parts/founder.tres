[gd_resource type="Resource" script_class="PartAssembly" format=3]
; The Founder (boss placeholder): the abbot of the foundry, the Precentor scaled by 1.2, its cope rusted and its
; vestments glowing like metal fresh from the mould. Placeholder until the character pass (docs/roadmap.md#stage-polish).

[ext_resource type="Resource" path="res://resources/parts/precentor.tres" id="1_base"]
[ext_resource type="Script" path="res://scripts/parts/PartAssembly.cs" id="2_PartAssembly"]
[ext_resource type="Material" path="res://assets/materials/machines/vestment.tres" id="3_vestment"]
[ext_resource type="Material" path="res://assets/materials/machines/robe.tres" id="4_robe"]
[ext_resource type="Material" path="res://assets/materials/machines/ember.tres" id="5_ember"]
[ext_resource type="Material" path="res://assets/materials/machines/corroded.tres" id="6_corroded"]

[resource]
script = ExtResource("2_PartAssembly")
Base = ExtResource("1_base")
Scale = 1.2
MaterialSwaps = Dictionary[Material, Material]({
ExtResource("3_vestment"): ExtResource("5_ember"),
ExtResource("4_robe"): ExtResource("6_corroded")
})
