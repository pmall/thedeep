[gd_resource type="Resource" script_class="PartAssembly" format=3]
; The Precentor (boss placeholder): the choir's conductor, a Votary half again as tall, with a long cope, a great
; glyph halo and a straight baton in place of the curved blade. Placeholder until the bosses are made
; (docs/roadmap.md#stage-polish). Its own parts and chains are in the Votary's size, scaled with the rest.

[ext_resource type="Resource" path="res://resources/parts/votary.tres" id="1_base"]
[ext_resource type="Script" path="res://scripts/parts/PartAssembly.cs" id="2_PartAssembly"]
[ext_resource type="Script" path="res://scripts/parts/PartSlot.cs" id="3_PartSlot"]
[ext_resource type="Script" path="res://scripts/parts/PartChain.cs" id="4_PartChain"]
[ext_resource type="Script" path="res://scripts/parts/PodMesh.cs" id="5_PodMesh"]
[ext_resource type="Script" path="res://scripts/parts/RingMesh.cs" id="6_RingMesh"]
[ext_resource type="Material" path="res://assets/materials/machines/prayer_wheel.tres" id="7_prayer_wheel"]
[ext_resource type="Material" path="res://assets/materials/machines/blade.tres" id="8_blade"]
[ext_resource type="Material" path="res://assets/materials/machines/robe.tres" id="9_robe"]

[sub_resource type="PrimitiveMesh" id="Mesh_halo"]
script = ExtResource("6_RingMesh")
RadiusX = 0.51
RadiusZ = 0.51
Height = 0.035
Thickness = 0.045
Segments = 48

[sub_resource type="Resource" id="Part_Halo"]
script = ExtResource("3_PartSlot")
Name = &"Halo"
Joint = &"Head"
Category = 4
Mesh = SubResource("Mesh_halo")
Material = ExtResource("7_prayer_wheel")
Position = Vector3(-0.2, 0.15, 0)
Rotation = Vector3(90, 0, 0)

[sub_resource type="PrimitiveMesh" id="Mesh_baton"]
script = ExtResource("5_PodMesh")
Length = 1.1875
Curl = 18
Stations = PackedVector4Array(0, 0.07, 0.025, 0, 0.15, 0.12, 0.02, 0.02, 0.8, 0.09, 0.015, 0.02, 1, 0, 0, 0)
Sides = 8
Rings = 16

[sub_resource type="Resource" id="Part_Blade"]
script = ExtResource("3_PartSlot")
Name = &"Blade"
Joint = &"ElbowN"
Category = 3
Mesh = SubResource("Mesh_baton")
Material = ExtResource("8_blade")
Position = Vector3(0, -0.28, 0)

[sub_resource type="Resource" id="Chain_Tabard"]
script = ExtResource("4_PartChain")
Name = &"Tabard"
Joint = &"Pelvis"
Category = 4
Offset = Vector3(-0.13, 0.02, 0)
RestDirection = Vector3(0, -1, 0)
Links = 6
Length = 1.17
Shape = 0
Material = ExtResource("9_robe")
Width = 0.24
Taper = 0.75
Thickness = 0.014
Drag = 1.5
Stiffness = 2.5

[resource]
script = ExtResource("2_PartAssembly")
Base = ExtResource("1_base")
Scale = 1.55
Parts = [SubResource("Part_Halo"), SubResource("Part_Blade")]
Chains = [SubResource("Chain_Tabard")]
