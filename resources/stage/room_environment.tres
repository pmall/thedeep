[gd_resource type="Environment" format=3]
; The environment every room shares (scenes/stage/RoomStage.tscn). Its colors, fog and grading are set by
; the room's BiomeProfile when the room loads; only the effects chosen here (SSR, SSAO, glow levels) stay.

[resource]
background_mode = 1
background_color = Color(0.018, 0.04, 0.045, 1)
ambient_light_source = 2
ambient_light_color = Color(0.3, 0.46, 0.5, 1)
ambient_light_energy = 0.35
tonemap_mode = 4
ssr_enabled = true
ssr_max_steps = 48
ssao_enabled = true
glow_enabled = true
glow_levels/2 = 0.6
glow_levels/3 = 1.0
glow_levels/4 = 0.7
glow_levels/5 = 0.4
glow_intensity = 0.6
glow_bloom = 0.02
glow_hdr_threshold = 0.9
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.05, 0.11, 0.12, 1)
fog_density = 1.0
fog_depth_begin = 24.0
fog_depth_end = 75.0
volumetric_fog_enabled = true
volumetric_fog_length = 72.0
volumetric_fog_detail_spread = 1.5

