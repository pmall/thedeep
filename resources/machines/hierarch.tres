[gd_resource type="Resource" script_class="MachineSpecies" format=3]
; The Hierarch (PrayerBehavior), a placeholder until the character pass: the priest-machine of the Sanctum, on the
; Precentor's tall body (cope, great glyph halo, a straight staff). It kneels and bows before the forbidden door and
; never strikes: its weapon is the order it gives (a Proclamation), and the second law that makes the pilgrim obey.

[ext_resource type="Script" path="res://scripts/machines/MachineSpecies.cs" id="1_species"]
[ext_resource type="Script" path="res://scripts/machines/behaviors/PrayerBehavior.cs" id="2_behavior"]
[ext_resource type="Script" path="res://scripts/machines/JointDriver.cs" id="3_driver"]
[ext_resource type="Script" path="res://scripts/machines/MachineLeg.cs" id="4_leg"]
[ext_resource type="Resource" path="res://resources/parts/precentor.tres" id="5_assembly"]

[sub_resource type="Resource" id="Behavior"]
script = ExtResource("2_behavior")
Period = 4.6
Reach = -10
Band = 0
ChestHeight = 1.9
Congregation = 0
Calm = 1

; a nod to the beat
[sub_resource type="Resource" id="Driver_0"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 6
Angle = -7

; draws back, then throws its weight into the blow
[sub_resource type="Resource" id="Driver_1"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 3
Angle = -24
WindUp = 14

; rises to its full height when the fight is on
[sub_resource type="Resource" id="Driver_2"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 4
Angle = 6

; breathing
[sub_resource type="Resource" id="Driver_3"]
