[gd_resource type="Resource" script_class="MachineSpecies" format=3]
; The Founder (ConductorBehavior), boss of the volcanic layer, a placeholder until the character pass: the abbot of
; the foundry. It strikes its hammer like a bell until it sees the pilgrim, then stalks it, slower and heavier than the
; Precentor, bringing the hammer down after a long wind-up and lunging further; every second strike a quicker one
; follows. The long recovery after a blow is the opening.

[ext_resource type="Script" path="res://scripts/machines/MachineSpecies.cs" id="1_species"]
[ext_resource type="Script" path="res://scripts/machines/behaviors/ConductorBehavior.cs" id="2_behavior"]
[ext_resource type="Script" path="res://scripts/machines/JointDriver.cs" id="3_driver"]
[ext_resource type="Script" path="res://scripts/machines/MachineLeg.cs" id="4_leg"]
[ext_resource type="Resource" path="res://resources/parts/founder.tres" id="5_assembly"]
[ext_resource type="Resource" path="res://resources/biomes/volcanic.tres" id="0_habitat"]

[sub_resource type="Resource" id="Behavior"]
script = ExtResource("2_behavior")
SightRange = 18
Reach = 3.6
Band = 2.2
ChestHeight = 2.3
Speed = 1.5
Lunge = 8
Flurry = 2
BeatPeriod = 1.6
WindUp = 0.85
Blow = 0.14
Recover = 1.25
Cooldown = 0.45
QuickWindUp = 0.42
QuickRecover = 1.3

; a nod to the beat
[sub_resource type="Resource" id="Driver_0"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 6
Angle = -7

; draws back, then throws its weight into the blow
[sub_resource type="Resource" id="Driver_1"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 3
Angle = -24
WindUp = 14

; rises to its full height when the fight is on
[sub_resource type="Resource" id="Driver_2"]
