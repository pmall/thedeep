[gd_resource type="Resource" script_class="MachineSpecies" format=3]
; The Votary (PrayerBehavior): kneels and bows before its shrine, in step with the Votaries near it.
; It ignores whoever walks behind it; whoever passes in front, between it and its devotion, is
; struck by its blade after a wind-up that warns: the head turns, the eye goes the hazard color.

[ext_resource type="Script" path="res://scripts/machines/MachineSpecies.cs" id="1_species"]
[ext_resource type="Script" path="res://scripts/machines/behaviors/PrayerBehavior.cs" id="2_behavior"]
