[gd_resource type="Resource" script_class="MachineSpecies" format=3]
; The Precentor (ConductorBehavior), boss of the flooded layer, a placeholder until the character pass:
; the choir's conductor in the Chapterhouse. It beats time with its baton until it sees the pilgrim, then
; stalks it and brings the baton down after a long wind-up, lunging into the blow; every third strike a
; quicker second one follows. The slow recovery after a blow is the opening.

[ext_resource type="Script" path="res://scripts/machines/MachineSpecies.cs" id="1_species"]
[ext_resource type="Script" path="res://scripts/machines/behaviors/ConductorBehavior.cs" id="2_behavior"]
[ext_resource type="Script" path="res://scripts/machines/JointDriver.cs" id="3_driver"]
[ext_resource type="Script" path="res://scripts/machines/MachineLeg.cs" id="4_leg"]
[ext_resource type="Resource" path="res://resources/parts/precentor.tres" id="5_assembly"]

[sub_resource type="Resource" id="Behavior"]
script = ExtResource("2_behavior")
SightRange = 16
Reach = 3
Band = 2.2
ChestHeight = 1.9
Speed = 1.7
Lunge = 7
Flurry = 3
BeatPeriod = 1.3
WindUp = 0.75
Blow = 0.14
Recover = 1.1
Cooldown = 0.45
QuickWindUp = 0.42
QuickRecover = 1.3

; a nod to the beat
[sub_resource type="Resource" id="Driver_0"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 6
Angle = -7

; draws back, then throws its weight into the blow
[sub_resource type="Resource" id="Driver_1"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 3
Angle = -24
WindUp = 14

; rises to its full height when the fight is on
[sub_resource type="Resource" id="Driver_2"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 0
Channel = 4
Angle = 6

; breathing
[sub_resource type="Resource" id="Driver_3"]
script = ExtResource("3_driver")
Joint = &"Spine"
Mode = 1
Channel = 0
Angle = 1
Rate = 0.2

[sub_resource type="Resource" id="Driver_4"]
script = ExtResource("3_driver")
Joint = &"Head"
Mode = 0
Channel = 6
Angle = -8

; watches its choir, or the intruder
[sub_resource type="Resource" id="Driver_5"]
