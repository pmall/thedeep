[gd_resource type="Resource" script_class="TextStyle" format=3]
; The game's text style (TextStyle): every world's on-screen text, unless a world gives its own.

[ext_resource type="Script" path="res://scripts/ui/TextStyle.cs" id="1_style"]
[ext_resource type="FontFile" path="res://assets/fonts/Jost.ttf" id="2_jost"]
[ext_resource type="FontFile" path="res://assets/fonts/Jost-world.ttf" id="3_jost_world"]

; Jost at a book weight: light and geometric, and still whole at the caption's size (2003265652 is the "wght" axis).
[sub_resource type="FontVariation" id="jost_book"]
base_font = ExtResource("2_jost")
variation_opentype = {
2003265652: 450
}

; The same face and weight for words standing in the world: a distance-field import with mipmaps (Jost-world.ttf).
[sub_resource type="FontVariation" id="jost_world_book"]
base_font = ExtResource("3_jost_world")
variation_opentype = {
2003265652: 450
}

