[gd_resource type="ShaderMaterial" format=3]
; Footstep grit and landing dust: lit by every light (unlike ambient motes), with a little glow so they
; stay visible on the floor in shade.

[ext_resource type="Shader" path="res://assets/shaders/particle.gdshader" id="1_shader"]

[resource]
shader = ExtResource("1_shader")
shader_parameter/shape = 0
shader_parameter/opacity = 0.85
shader_parameter/glow = 0.25
shader_parameter/key_light = 1.0
shader_parameter/light_gain = 1.5
