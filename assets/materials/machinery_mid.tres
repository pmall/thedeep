; The plating of the machinery on the walls behind a room (WallDressing: banks of pipes, pistons): the metal's color, far
; darker and duller than grippable metal, worn and hazed by its depth, so its forms read in the murk as midground and it
; never reads as metal the pilgrim could grip.
[resource]
shader = ExtResource("1_shader")
shader_parameter/panels_normal = ExtResource("2_panels_normal")
shader_parameter/panels_surface = ExtResource("3_panels_surface")
shader_parameter/coating_normal = ExtResource("4_coating_normal")
shader_parameter/coating_surface = ExtResource("5_coating_surface")
shader_parameter/panel_size = Vector2(6, 6)
shader_parameter/rivet_share = 0.2
shader_parameter/shade = 0.3
shader_parameter/dull = 0.7
shader_parameter/corrosion = 0.45
shader_parameter/clearcoat = 0.0
shader_parameter/rim = 0.0
shader_parameter/streaks = 0.6
shader_parameter/haze_per_meter = 0.024
shader_parameter/haze_max = 0.6
