[gd_resource type="ShaderMaterial" format=3]

; The section of a deep cave's water (the Underice): its play plane lies twenty meters and more under the surface, where
; water_section.tres sinks the view almost wholly into the deep color, lamps and all. Clearer and slower to absorb,
; so the lit cave and the pilgrim read through it.
[ext_resource type="Shader" path="res://assets/shaders/water_section.gdshader" id="1_shader"]

[resource]
render_priority = 1
shader = ExtResource("1_shader")
shader_parameter/absorption = 0.025
shader_parameter/clarity = 0.88
