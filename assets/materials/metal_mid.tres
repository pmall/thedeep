[gd_resource type="ShaderMaterial" format=3]

[ext_resource type="Shader" path="res://assets/shaders/metal.gdshader" id="1_shader"]
[ext_resource type="Texture2D" uid="uid://dtskp5h7tj8qy" path="res://assets/textures/surfaces/panels_normal.png" id="2_panels_normal"]
[ext_resource type="Texture2D" uid="uid://cbdkgpfpxgqev" path="res://assets/textures/surfaces/panels_surface.png" id="3_panels_surface"]
[ext_resource type="Texture2D" uid="uid://c5007l1afd5cs" path="res://assets/textures/surfaces/coating_normal.png" id="4_coating_normal"]
[ext_resource type="Texture2D" uid="uid://bgkpcowsa62j3" path="res://assets/textures/surfaces/coating_surface.png" id="5_coating_surface"]

; Metal behind the play plane (racks, machinery): darker and duller than grippable metal; nobody grips it, so in the
; cold it takes rime like stone (frost_share), which keeps it from reading as grippable metal.
[resource]
shader = ExtResource("1_shader")
shader_parameter/panels_normal = ExtResource("2_panels_normal")
shader_parameter/panels_surface = ExtResource("3_panels_surface")
shader_parameter/coating_normal = ExtResource("4_coating_normal")
shader_parameter/coating_surface = ExtResource("5_coating_surface")
shader_parameter/shade = 0.5
shader_parameter/corrosion = 0.4
shader_parameter/clearcoat = 0.3
shader_parameter/rim = 0.1
shader_parameter/frost_share = 0.9
