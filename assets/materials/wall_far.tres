[gd_resource type="ShaderMaterial" format=3]

[ext_resource type="Shader" path="res://assets/shaders/rock.gdshader" id="1_shader"]
[ext_resource type="Texture2D" uid="uid://6hejw2e4jach" path="res://assets/textures/surfaces/strata_normal.png" id="2_normal"]
[ext_resource type="Texture2D" uid="uid://4q4ph45vstq4" path="res://assets/textures/surfaces/strata_surface.png" id="3_surface"]
[ext_resource type="Texture2D" uid="uid://nbsorywnpvq5" path="res://assets/textures/surfaces/masonry_normal.png" id="4_masonry_normal"]
[ext_resource type="Texture2D" uid="uid://cyd8ptbp7r31i" path="res://assets/textures/surfaces/masonry_surface.png" id="5_masonry_surface"]

; The far wall of a room whose back is dressed with machinery (the core's Kit/Back): the bare rock the works are set in,
; strata where the play plane is built of cut stone and far darker than stone_mid, so nothing behind the play plane
; takes its value or its texture (docs/art-direction.md#midground); the depth fog veils it further.
[resource]
shader = ExtResource("1_shader")
shader_parameter/strata_normal = ExtResource("2_normal")
shader_parameter/strata_surface = ExtResource("3_surface")
shader_parameter/masonry_normal = ExtResource("4_masonry_normal")
shader_parameter/masonry_surface = ExtResource("5_masonry_surface")
shader_parameter/masonry_share = 0.0
shader_parameter/detail = false
shader_parameter/shade = 0.28
shader_parameter/strata_contrast = 0.05
