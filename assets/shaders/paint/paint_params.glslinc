// The painted pass's shared parameters (PaintPass writes them once a frame, PaintStyle holds the strengths) and
// helpers. Included by every paint_*.glsl compute shader; binding 0 of set 0 in each.
//
// Colors inside the pass are "pigment": HDR linear color compressed per channel by c / (1 + c), so they sit in
// [0, 1) where variance and value bands make sense; the composite expands them back.

layout(set = 0, binding = 0, std140) uniform Params {
	vec4 size;        // full width, height; half width, height
	vec4 lens;        // depth terms A, B of the projection (view depth = B / (d + A)), tan(half vertical fov), aspect
	vec4 cam_right;   // camera right (world); w: distance from the camera to the play plane
	vec4 cam_up;      // camera up (world); w: seconds
	vec4 cam_forward; // camera view direction (world)
	vec4 cam_origin;  // camera position (world)
	vec4 brush;       // radius on the play plane, radius far (half-res pixels), sharpness, anisotropy
	vec4 brush2;      // mechanical (0..1), strength (0..1), detail kept on the play plane (0..1), wobble (screen pixels)
	vec4 pigment;     // pooling, granulation, grain cell (screen pixels), glyph share (0..1)
	vec4 tone;        // value bands (count), band strength, palette pull, stroke growth with depth
	vec4 hand;        // pigment density variation (0..1), stroke size (screen pixels), strokes (0..1), stroke jitter (0..1)
	vec4 palette[6];  // pigments (pigment space rgb); w: 1 when used
} p;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// Also cleans the HDR input: a very bright pixel can overflow half floats to infinity, and inf / inf is NaN, which would
// spread through every step after.
vec3 to_pigment(vec3 c) {
	c = clamp(c, vec3(0.0), vec3(60000.0));
	c = mix(c, vec3(0.0), bvec3(isnan(c.r), isnan(c.g), isnan(c.b)));
	return c / (1.0 + c);
}

vec3 from_pigment(vec3 x) {
	x = min(x, vec3(0.9995));
	return x / (1.0 - x);
}

// View depth (meters along the view direction) from the reverse-Z depth buffer: the device projection maps view depth
// z to d = (B - A z) / z.
// Never NaN, infinite or behind the camera: anything odd reads as the far plane.
float view_depth(float d) {
	float z = p.lens.y / (d + p.lens.x);
	float far_ = p.lens.y / p.lens.x;
	return (isnan(z) || isinf(z) || z <= 0.0) ? far_ : min(z, far_);
}

// The world position seen at uv (0..1, y down) at view depth z.
vec3 world_at(vec2 uv, float z) {
	vec2 ndc = uv * 2.0 - 1.0;
	vec3 dir = p.cam_forward.xyz
		+ p.cam_right.xyz * (ndc.x * p.lens.z * p.lens.w)
		- p.cam_up.xyz * (ndc.y * p.lens.z);
	return p.cam_origin.xyz + dir * z;
}

// Meters covered by one full-res pixel at view depth z.
float pixel_meters(float z) {
	return 2.0 * z * p.lens.z / p.size.y;
}

float hash12(vec2 q) {
	vec3 q3 = fract(vec3(q.xyx) * 0.1031);
	q3 += dot(q3, q3.yzx + 33.33);
	return fract((q3.x + q3.y) * q3.z);
}

// Four hashes of one cell at once.
vec4 hash42(vec2 q) {
	vec4 p4 = fract(vec4(q.xyxy) * vec4(0.1031, 0.1030, 0.0973, 0.1099));
	p4 += dot(p4, p4.wzxy + 33.33);
	return fract((p4.xxyz + p4.yzzw) * p4.zywx);
}

float value_noise(vec2 q) {
	vec2 i = floor(q);
	vec2 f = fract(q);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash12(i);
	float b = hash12(i + vec2(1.0, 0.0));
	float c = hash12(i + vec2(0.0, 1.0));
	float d = hash12(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
